<%- include('../layout/adminlayout.ejs') -%>
  <div class="container-scroller">

    <%- include('../layout/adminnav.ejs') -%>

      <div class="main-panel">
        <div class="content-wrapper">

          <div class="row ">
            <div class="circle position-absolute " style="background-color: rebeccapurple;
            filter: blur(136px);
            width: 13rem;
            height: 10rem;
            border-radius: 50%;
            transform: translate(57rem, 23rem);"></div>
            <div class="circle position-absolute " style="background-color: rgba(0, 0, 255, 0.589);
            filter: blur(136px);
            width: 13rem;
            height: 10rem;
            border-radius: 50%;
         "></div>
            <div class="col-12 grid-margin">
              <div class="card " style="height: 80vh; border-radius: 15px; box-shadow: 0 0 0 0; border: 0;">
                <div class="card" style="border-radius: 15px; box-shadow: 0 0 0 0; border: 0;">
                  <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between ">
                      <h4 class="card-title">offers</h4>
                      <a href="/admin/offers/new" class="btn btn-primary text-white "
                        style="outline: 0; border:0; margin-top: -1rem;">Add offer</a>
                    </div>

                    <!-- Search Bar -->
                    <div class="offer-search-wrapper" style="margin-bottom: 1.2rem;">
                      <div class="offer-search-box">
                        <svg class="offer-search-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <circle cx="11" cy="11" r="8"></circle>
                          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                        </svg>
                        <input
                          type="text"
                          id="offerSearchInput"
                          class="offer-search-input"
                          placeholder="Search offers..."
                          autocomplete="off"
                        />
                        <div class="offer-search-loader" id="offerSearchLoader" style="display:none;">
                          <div class="offer-search-spinner"></div>
                        </div>
                        <button class="offer-search-clear" id="offerSearchClear" style="display:none;" title="Clear search">
                          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                          </svg>
                        </button>
                      </div>
                    </div>
                    <div class="table-responsive">
                      <form action="/admin/offers" method="post">
                        <table class="table">
                          <thead>
                            <tr>
                              <th>
                                No
                              </th>
                              <th> Name </th>
                              <th> offer </th>
                              <th> products </th>
                              <th> category </th>
                              <th> options </th>


                            </tr>
                          </thead>
                          <tbody id="offerTableBody">
                            <%locals.offer.forEach((e,i)=>{%>
                              <tr>
                                <td>
                                  <%=i+1 %>
                                </td>
                                <td>
                                  <%=e.name %>
                                </td>
                                <td>
                                  <%=e.offer %>%
                                </td>
                                <td> <a href="/admin/offers/<%=e._id  %>/products" class=" ">add product</a> </td>
                                <td> <a href="/admin/offers/<%=e._id  %>/categories" class=" ">add category</a> </td>
                                <td>
                                  <div class="d-flex justify-content-start  align-items-center  " style="gap: 1rem;">
                                    <h4><a href="/admin/offers/<%=e._id  %>/edit" class="text-white text-decoration-none "><i
                                          class="ri-edit-circle-fill" style="cursor: pointer;"></i></a></h4>
                                          <h4><a onclick="gg('<%=e._id%>')" class="text-white text-decoration-none "><i class="ri-delete-bin-line" style="cursor: pointer;"></i></a></h4>
                                  </div>
                                </td>
                              </tr>
                              <% }) %>
                          </tbody>
                        </table>

                      </form>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
  </div>
  </div>
  <script src="sweetalert2/dist/sweetalert2.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script>
    function gg(id){
      Swal.fire({
        title: "Are you sure?",
        text: "You won't be able to revert this!",
        icon: "warning",
        showCancelButton: true,
        confirmButtonColor: "#3085d6",
        cancelButtonColor: "#d33",
        confirmButtonText: "Yes, delete it!"
      }).then((result) => {
        if (result.isConfirmed){

          window.location.href=`/admin/offers/remove/${id}`;
        }})
    }
  </script>

  <!-- Offer Search Script -->
  <script>
  (function() {
    const searchInput = document.getElementById('offerSearchInput');
    const searchLoader = document.getElementById('offerSearchLoader');
    const searchClear = document.getElementById('offerSearchClear');
    const tableBody = document.getElementById('offerTableBody');
    let debounceTimer = null;
    let currentQuery = '';

    searchInput.addEventListener('input', function() {
      const query = this.value.trim();
      currentQuery = query;
      searchClear.style.display = query.length > 0 ? 'flex' : 'none';
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(() => {
        performSearch(query);
      }, 400);
    });

    searchClear.addEventListener('click', function() {
      searchInput.value = '';
      currentQuery = '';
      searchClear.style.display = 'none';
      performSearch('');
      searchInput.focus();
    });

    function performSearch(query) {
      searchLoader.style.display = 'flex';
      fetch(`/admin/offers?q=${encodeURIComponent(query)}`, {
        headers: { 'Accept': 'application/json' }
      })
        .then(res => res.json())
        .then(data => {
          renderTable(data.offer);
          searchLoader.style.display = 'none';
        })
        .catch(err => {
          console.error('Offer search error:', err);
          searchLoader.style.display = 'none';
        });
    }

    function renderTable(offers) {
      if (!offers || offers.length === 0) {
        tableBody.innerHTML = `
          <tr>
            <td colspan="6" style="text-align:center; padding: 2.5rem 0;">
              <div style="display:flex; flex-direction:column; align-items:center; gap:0.5rem; opacity:0.6;">
                <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="opacity:0.4;">
                  <circle cx="11" cy="11" r="8"></circle>
                  <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                  <line x1="8" y1="11" x2="14" y2="11"></line>
                </svg>
                <span style="font-size:0.95rem;">No offers found</span>
              </div>
            </td>
          </tr>`;
        return;
      }

      tableBody.innerHTML = offers.map((e, i) => `
        <tr style="animation: fadeInOfferRow 0.25s ease ${i * 0.04}s both;">
          <td>${i + 1}</td>
          <td>${e.name}</td>
          <td>${e.offer}%</td>
          <td><a href="/admin/offers/${e._id}/products" class="">add product</a></td>
          <td><a href="/admin/offers/${e._id}/categories" class="">add category</a></td>
          <td>
            <div class="d-flex justify-content-start align-items-center" style="gap: 1rem;">
              <h4><a href="/admin/offers/${e._id}/edit" class="text-white text-decoration-none"><i class="ri-edit-circle-fill" style="cursor: pointer;"></i></a></h4>
              <h4><a onclick="gg('${e._id}')" class="text-white text-decoration-none"><i class="ri-delete-bin-line" style="cursor: pointer;"></i></a></h4>
            </div>
          </td>
        </tr>
      `).join('');
    }
  })();
  </script>
  
