<%- include('../layout/adminlayout.ejs') -%>
  <div class="container-scroller">
    <%- include('../layout/adminnav.ejs') -%>
    <div class="main-panel">
      <div class="content-wrapper" style="padding: 1.5rem 2.2rem;">
        <div class="row">
          <!-- Background Blurs -->
          <div class="circle position-fixed" style="background-color: rebeccapurple; filter: blur(140px); width: 14rem; height: 11rem; border-radius: 50%; right: 5rem; top: 15rem; z-index: 0; pointer-events: none; opacity: 0.5;"></div>
          <div class="circle position-fixed" style="background-color: rgba(0, 0, 255, 0.4); filter: blur(140px); width: 14rem; height: 11rem; border-radius: 50%; left: 18rem; top: 8rem; z-index: 0; pointer-events: none; opacity: 0.5;"></div>

          <div class="col-12 grid-margin" style="position: relative; z-index: 1;">
            <div class="offer-container-glass">
              <div class="d-flex align-items-center justify-content-between mb-4">
                <div>
                  <h3 class="offer-page-title">Active Offers</h3>
                  <p class="offer-page-subtitle text-muted">Manage store-wide discounts and promotions</p>
                </div>
                <a href="/admin/offers/new" class="offer-add-primary-btn">
                  <i class="ri-add-line"></i> Add New Offer
                </a>
              </div>

              <!-- Search Bar -->
              <div class="offer-search-wrapper">
                <div class="offer-search-box">
                  <i class="ri-search-line offer-search-icon"></i>
                  <input
                    type="text"
                    id="offerSearchInput"
                    class="offer-search-input"
                    placeholder="Search offers by name..."
                    autocomplete="off"
                  />
                  <div class="offer-search-loader" id="offerSearchLoader" style="display:none;">
                    <div class="offer-search-spinner"></div>
                  </div>
                  <button class="offer-search-clear" id="offerSearchClear" style="display:none;" title="Clear search">
                    <i class="ri-close-line"></i>
                  </button>
                </div>
              </div>

              <div class="table-responsive mt-3">
                <table class="offer-custom-table">
                  <thead>
                    <tr>
                      <th style="width: 60px;">No</th>
                      <th>Offer Name</th>
                      <th>Discount</th>
                      <th class="text-center">Manage Selection</th>
                      <th class="text-end">Actions</th>
                    </tr>
                  </thead>
                  <tbody id="offerTableBody">
                    <% locals.offer.forEach((e, i) => { %>
                    <% let rowDelay = (i * 0.05).toFixed(2) + 's'; %>
                    <tr class="offer-row" style="--row-delay: <%= rowDelay %>;">
                      <td class="offer-index"><%= i + 1 %></td>
                      <td>
                        <div class="offer-name-cell">
                          <span class="offer-name-txt"><%= e.name %></span>
                        </div>
                      </td>
                      <td>
                        <div class="offer-discount-badge">
                          <i class="ri-verified-badge-line me-1"></i>
                          <span><%= e.offer %>% OFF</span>
                        </div>
                      </td>
                      <td>
                        <div class="d-flex justify-content-center align-items-center gap-2">
                          <a href="/admin/offers/<%= e._id %>/products" class="offer-action-link product" title="Add Products">
                            <i class="ri-box-3-line"></i>
                            <span>Products</span>
                          </a>
                          <a href="/admin/offers/<%= e._id %>/categories" class="offer-action-link category" title="Add Categories">
                            <i class="ri-layout-grid-line"></i>
                            <span>Categories</span>
                          </a>
                        </div>
                      </td>
                      <td>
                        <div class="d-flex justify-content-end align-items-center gap-3">
                          <a href="/admin/offers/<%= e._id %>/edit" class="offer-icon-btn edit" title="Edit Offer">
                            <i class="ri-edit-line"></i>
                          </a>
                          <button onclick="gg('<%= e._id %>')" class="offer-icon-btn delete" title="Delete Offer">
                            <i class="ri-delete-bin-line"></i>
                          </button>
                        </div>
                      </td>
                    </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script>
    function gg(id) {
      Swal.fire({
        title: "Are you sure?",
        text: "This will remove the offer from all associated products/categories!",
        icon: "warning",
        showCancelButton: true,
        confirmButtonColor: "#8860d0",
        cancelButtonColor: "#d33",
        confirmButtonText: "Yes, delete it!",
        background: '#12151c',
        color: '#fff'
      }).then((result) => {
        if (result.isConfirmed) {
          window.location.href = `/admin/offers/remove/${id}`;
        }
      })
    }

    // Offer Search Logic
    (function() {
      const searchInput = document.getElementById('offerSearchInput');
      const searchLoader = document.getElementById('offerSearchLoader');
      const searchClear = document.getElementById('offerSearchClear');
      const tableBody = document.getElementById('offerTableBody');
      let debounceTimer = null;

      searchInput.addEventListener('input', function() {
        const query = this.value.trim();
        searchClear.style.display = query.length > 0 ? 'flex' : 'none';
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(() => performSearch(query), 400);
      });

      searchClear.addEventListener('click', function() {
        searchInput.value = '';
        searchClear.style.display = 'none';
        performSearch('');
        searchInput.focus();
      });

      function performSearch(query) {
        searchLoader.style.display = 'flex';
        fetch(`/admin/offers?q=${encodeURIComponent(query)}`, {
          headers: { 'Accept': 'application/json' }
        })
          .then(res => res.json())
          .then(data => {
            renderTable(data.offer);
            searchLoader.style.display = 'none';
          })
          .catch(err => {
            console.error('Offer search error:', err);
            searchLoader.style.display = 'none';
          });
      }

      function renderTable(offers) {
        if (!offers || offers.length === 0) {
          tableBody.innerHTML = `
            <tr>
              <td colspan="5" style="text-align:center; padding: 4rem 0;">
                <div class="offer-empty-state">
                  <i class="ri-coupon-2-line"></i>
                  <p>No offers match your search criteria</p>
                </div>
              </td>
            </tr>`;
          return;
        }

        tableBody.innerHTML = offers.map((e, i) => `
          <tr class="offer-row" style="--row-delay: ${(i * 0.05).toFixed(2) + 's'};">
            <td class="offer-index">${i + 1}</td>
            <td>
              <div class="offer-name-cell">
                <span class="offer-name-txt">${e.name}</span>
              </div>
            </td>
            <td>
              <div class="offer-discount-badge">
                <i class="ri-verified-badge-line me-1"></i>
                <span>${e.offer}% OFF</span>
              </div>
            </td>
            <td>
              <div class="d-flex justify-content-center align-items-center gap-2">
                <a href="/admin/offers/${e._id}/products" class="offer-action-link product" title="Add Products">
                  <i class="ri-box-3-line"></i>
                  <span>Products</span>
                </a>
                <a href="/admin/offers/${e._id}/categories" class="offer-action-link category" title="Add Categories">
                  <i class="ri-layout-grid-line"></i>
                  <span>Categories</span>
                </a>
              </div>
            </td>
            <td>
              <div class="d-flex justify-content-end align-items-center gap-3">
                <a href="/admin/offers/${e._id}/edit" class="offer-icon-btn edit" title="Edit Offer">
                  <i class="ri-edit-line"></i>
                </a>
                <button onclick="gg('${e._id}')" class="offer-icon-btn delete" title="Delete Offer">
                  <i class="ri-delete-bin-line"></i>
                </button>
              </div>
            </td>
          </tr>
        `).join('');
      }
    })();
  </script>

  <style>
    :root {
      --accent: #8860d0;
      --accent-soft: rgba(136, 96, 208, 0.15);
      --glass-bg: rgba(255, 255, 255, 0.04);
      --glass-border: rgba(255, 255, 255, 0.08);
      --text-soft: rgba(255, 255, 255, 0.6);
    }

    .offer-container-glass {
      background: var(--glass-bg);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid var(--glass-border);
      border-radius: 20px;
      padding: 1.8rem;
      min-height: 75vh;
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
    }

    .offer-page-title {
      font-size: 1.6rem;
      font-weight: 700;
      letter-spacing: -0.02em;
      margin-bottom: 0.2rem;
    }

    .offer-page-subtitle {
      font-size: 0.9rem;
    }

    .offer-add-primary-btn {
      background: var(--accent);
      color: white;
      border: none;
      padding: 0.6rem 1.2rem;
      border-radius: 10px;
      font-weight: 600;
      font-size: 0.9rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      transition: all 0.3s ease;
      text-decoration: none;
    }

    .offer-add-primary-btn:hover {
      background: #9d78e3;
      transform: translateY(-2px);
      color: white;
      box-shadow: 0 4px 15px rgba(136, 96, 208, 0.3);
      text-decoration: none;
    }

    /* Search Styles */
    .offer-search-wrapper { position: relative; margin-bottom: 0.5rem; }
    .offer-search-box {
      display: flex; align-items: center; gap: 0.8rem; padding: 0.7rem 1.2rem;
      border-radius: 12px; background: rgba(0, 0, 0, 0.2);
      border: 1px solid var(--glass-border); transition: all 0.3s ease;
    }
    .offer-search-box:focus-within {
      border-color: var(--accent);
      background: rgba(0, 0, 0, 0.3);
      box-shadow: 0 0 0 3px rgba(136, 96, 208, 0.1);
    }
    .offer-search-icon { color: var(--text-soft); font-size: 1.1rem; }
    .offer-search-input {
      flex: 1; border: none; outline: none; background: transparent;
      color: #fff; font-size: 0.92rem;
    }
    .offer-search-clear {
      background: none; border: none; color: var(--text-soft);
      font-size: 1.2rem; cursor: pointer; transition: color 0.2s;
    }
    .offer-search-clear:hover { color: #d72624; }
    .offer-search-spinner {
      width: 18px; height: 18px; border: 2px solid rgba(136, 96, 208, 0.2);
      border-top-color: var(--accent); border-radius: 50%; animation: spin 0.6s linear infinite;
    }

    /* Table Styles */
    .offer-custom-table { width: 100%; border-collapse: separate; border-spacing: 0 8px; }
    .offer-custom-table th {
      padding: 0.8rem 1rem; color: var(--text-soft); font-size: 0.8rem;
      text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600;
      border-bottom: 1px solid var(--glass-border);
    }
    .offer-row { transition: all 0.2s ease; animation: fadeInRow 0.3s ease both; animation-delay: var(--row-delay, 0s); }
    .offer-row td {
      padding: 1rem; background: rgba(0, 0, 0, 0.15);
      border-top: 1px solid var(--glass-border);
      border-bottom: 1px solid var(--glass-border);
    }
    .offer-row td:first-child { border-left: 1px solid var(--glass-border); border-top-left-radius: 12px; border-bottom-left-radius: 12px; }
    .offer-row td:last-child { border-right: 1px solid var(--glass-border); border-top-right-radius: 12px; border-bottom-right-radius: 12px; }
    .offer-row:hover td { background: rgba(136, 96, 208, 0.05); border-color: rgba(136, 96, 208, 0.3); }

    .offer-index { font-family: monospace; color: var(--text-soft); }
    .offer-name-txt { font-weight: 600; color: #fff; font-size: 0.95rem; }
    
    .offer-discount-badge {
      display: inline-flex; align-items: center; padding: 0.35rem 0.8rem;
      background: var(--accent-soft); color: #c4b5fd; border-radius: 20px;
      font-size: 0.8rem; font-weight: 600; border: 1px solid rgba(136, 96, 208, 0.2);
    }

    .offer-action-link {
      display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.4rem 0.8rem;
      border-radius: 8px; font-size: 0.82rem; font-weight: 500;
      transition: all 0.2s ease; text-decoration: none; border: 1px solid transparent;
    }
    .offer-action-link.product { background: rgba(30, 41, 59, 0.4); color: #94a3b8; }
    .offer-action-link.category { background: rgba(15, 23, 42, 0.4); color: #94a3b8; }
    .offer-action-link:hover { transform: translateY(-1px); border-color: var(--accent); color: var(--accent); text-decoration: none; }

    .offer-icon-btn {
      width: 34px; height: 34px; display: flex; align-items: center; justify-content: center;
      border-radius: 8px; font-size: 1.1rem; transition: all 0.2s ease; background: rgba(255, 255, 255, 0.05);
      border: 1px solid transparent; text-decoration: none;
    }
    .offer-icon-btn.edit { color: #8860d0; }
    .offer-icon-btn.delete { color: #d72624; border: none; outline: none; }
    .offer-icon-btn:hover { background: rgba(255, 255, 255, 0.1); transform: scale(1.05); text-decoration: none; }

    .offer-empty-state {
      display: flex; flex-direction: column; align-items: center; gap: 0.5rem; opacity: 0.4;
    }
    .offer-empty-state i { font-size: 3rem; }

    @keyframes spin { to { transform: rotate(360deg); } }
    @keyframes fadeInRow { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

    body::-webkit-scrollbar { width: 0; }
    body { overflow: hidden !important; background: #0f1116; }
    .container-scroller { overflow: hidden; }
  </style>

  <script src="/vendors/js/vendor.bundle.base.js"></script>
  <script src="/js/off-canvas.js"></script>
  <script src="/js/hoverable-collapse.js"></script>
  <script src="/js/misc.js"></script>
  <script src="/js/settings.js"></script>
  <script src="/js/todolist.js"></script>
  </body>
</html>