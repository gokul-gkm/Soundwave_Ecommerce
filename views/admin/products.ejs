<%- include('../layout/adminlayout.ejs') -%>
<link rel="stylesheet" href="/css/admin/products.css">
  <div class="container-scroller">

    <%- include('../layout/adminnav.ejs') -%>

      <div class="main-panel ">
        <div class="content-wrapper  d-flex flex-column  align-items-center">
          <!-- Edit Product Modal (Glassmorphism) -->
          <link rel="stylesheet" href="/css/admin/productsEditModal.css" />
          <div class="edit-modal-overlay" id="editProductModal">
            <div class="edit-modal-card">
              <form id="myForm1" method="post" enctype="multipart/form-data">
                
                <div class="edit-modal-header">
                  <h3 class="edit-modal-title"><i class="mdi mdi-pencil-circle-outline"></i> Edit Product</h3>
                  <button type="button" class="btn-close-modal" aria-label="Close" onclick="closeEditModal()"><i class="mdi mdi-close"></i></button>
                </div>
                
                <div class="edit-modal-body">
                  <div class="edit-img-grid img-row">
                    <!-- Dynamic images go here -->
                  </div>

                  <div class="edit-form-group">
                    <label class="edit-form-label"><i class="mdi mdi-format-title"></i> Name</label>
                    <input type="text" class="edit-form-control name" name="name" required placeholder="Product Name">
                    <p id="err1" class="text-danger mt-1 mb-0" style="font-size: 12px;"></p>
                  </div>

                  <div class="edit-form-row">
                    <div class="edit-form-group">
                      <label class="edit-form-label"><i class="mdi mdi-currency-usd"></i> Price (₹)</label>
                      <input type="number" class="edit-form-control price" min="0" name="price" required placeholder="0.00">
                    </div>
                    <div class="edit-form-group">
                      <label class="edit-form-label"><i class="mdi mdi-package-variant-closed"></i> Stock</label>
                      <input type="number" class="edit-form-control stock" min="0" name="stock" required placeholder="0">
                    </div>
                  </div>

                  <div class="edit-form-row">
                    <div class="edit-form-group">
                      <label class="edit-form-label"><i class="mdi mdi-tag-outline"></i> Category</label>
                      <select class="edit-form-control category" name="category" required>
                        <% locals.ca.forEach(e=>{ %>
                          <option><%= e.name %></option>
                        <% }) %>
                      </select>
                    </div>
                    <div class="edit-form-group">
                      <label class="edit-form-label"><i class="mdi mdi-label-multiple-outline"></i> Tags</label>
                      <input type="text" class="edit-form-control tags" name="tags" placeholder="e.g. tech, wireless">
                    </div>
                  </div>

                  <div class="edit-form-group mb-0">
                    <label class="edit-form-label"><i class="mdi mdi-text-box-outline"></i> Description</label>
                    <textarea class="edit-form-control description" name="des" rows="3" required></textarea>
                  </div>
                </div>

                <div class="edit-modal-footer">
                  <button type="button" class="em-btn-cancel" onclick="closeEditModal()">Cancel</button>
                  <button type="submit" class="em-btn-submit"><i class="mdi mdi-check-circle-outline"></i> Update Product</button>
                </div>

              </form>
            </div>
          </div>

        <!-- Background Blurs -->
        <div class="circle position-fixed" style="background-color: rebeccapurple; filter: blur(140px); width: 14rem; height: 11rem; border-radius: 50%; right: 5rem; top: 15rem; z-index: 0; opacity: 0.4; pointer-events: none;"></div>
        <div class="circle position-fixed" style="background-color: rgba(0, 0, 255, 0.35); filter: blur(140px); width: 14rem; height: 11rem; border-radius: 50%; left: 18rem; top: 8rem; z-index: 0; opacity: 0.4; pointer-events: none;"></div>

        <div class="col-12 grid-margin" style="position: relative; z-index: 1;">
          <div class="user-container-glass">
            <div class="d-flex align-items-center justify-content-between mb-4">
              <div>
                <h3 class="user-page-title">Product Management</h3>
                <p class="user-page-subtitle text-muted">View, add, edit, and manage store products</p>
              </div>
              <a href="/admin/products/new" class="btn-add-product">
                <i class="ri-add-line"></i> Add Product
              </a>
            </div>

            <!-- Search Bar -->
            <div class="user-search-wrapper mb-4">
              <div class="user-search-box">
                <i class="ri-search-line user-search-icon"></i>
                <input
                  type="text"
                  id="productSearchInput"
                  class="product-search-input"
                  placeholder="Search products by name..."
                  autocomplete="off"
                />
                <div class="product-search-loader" id="productSearchLoader" style="display:none;">
                  <div class="product-search-spinner"></div>
                </div>
                <button class="product-search-clear" id="productSearchClear" style="display:none;" title="Clear search">
                  <i class="ri-close-line"></i>
                </button>
              </div>
            </div>

            <div class="table-responsive">
              <table class="user-custom-table">
                <thead>
                  <tr>
                    <th style="width: 50px;">No</th>
                    <th>Product</th>
                    <th>Images</th>
                    <th>Stock</th>
                    <th>Price</th>
                    <th>Category</th>
                    <th class="text-center">Listing</th>
                    <th class="text-end" style="width: 130px;">Actions</th>
                  </tr>
                </thead>
                <tbody id="productTableBody">
                  <% product.forEach((e, i)=>{ %>
                    <tr class="user-row" id="e<%=e._id %>" style="--row-delay: <%= (i * 0.05).toFixed(2) + 's' %>;">
                      <td data-label="No." class="user-index"><%= i + 1 %></td>
                      <td data-label="Product" class="font-weight-bold text-white product-name-cell"><%= e.name %></td>
                      <td data-label="Images">
                        <div class="product-images-overlap">
                          <% (e.images || []).forEach((im, idx)=>{ %>
                            <div class="product-image-avatar">
                              <img src="<%= im.startsWith('http') ? im : '/productImage/' + im %>" alt="product image" onerror="this.src='/images/no-image.png'">
                            </div>
                          <% }) %>
                        </div>
                      </td>
                      <td data-label="Stock">
                        <% if (e.stock === 0) { %>
                          <span class="stock-badge out-of-stock">Out of Stock</span>
                        <% } else if (e.stock <= 5) { %>
                          <span class="stock-badge low-stock">Only <%= e.stock %> left</span>
                        <% } else { %>
                          <span class="stock-badge in-stock"><%= e.stock %> Units</span>
                        <% } %>
                      </td>
                      <td data-label="Price" class="font-weight-bold text-white">₹<%= e.price.toFixed(2) %></td>
                      <td data-label="Category">
                        <span class="product-category-tag"><%= e.category ? e.category.name : 'N/A' %></span>
                      </td>
                      <td data-label="Listing" class="text-center">
                        <label class="user-toggle" title="<%= e.listed ? 'Unlist Product' : 'List Product' %>">
                          <input type="checkbox" <%= e.listed ? "checked" : "" %> onchange="active('<%= e._id %>')">
                          <span class="user-toggle-slider"></span>
                        </label>
                      </td>
                      <td data-label="Actions">
                        <div class="product-action-group">
                          <a href="/admin/products/<%= e._id %>" class="product-action-btn view" title="View Details">
                            <i class="ri-eye-line"></i>
                          </a>
                          <button 
                            onclick="openEditProductModal(this)" 
                            class="product-action-btn edit" 
                            title="Edit Product"
                            data-id="<%= e._id %>"
                            data-name="<%= e.name %>"
                            data-images="<%= JSON.stringify(e.images || []) %>"
                            data-stock="<%= e.stock %>"
                            data-price="<%= e.price %>"
                            data-category="<%= e.category ? e.category.name : '' %>"
                            data-description="<%= e.description %>"
                            data-tags="<%= e.tags ? e.tags.join(', ') : '' %>"
                          >
                            <i class="ri-edit-line"></i>
                          </button>
                          <button onclick="deleteProduct('<%= e._id %>')" class="product-action-btn delete" title="Delete Product">
                            <i class="ri-delete-bin-line"></i>
                          </button>
                        </div>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>

            <div id="productPaginationContainer" class="mt-4">
              <%- include('../layout/pagination.ejs') -%>
            </div>

          </div>
        </div>
        </div>
      </div>
  </div>
  </div>


  <!-- SweetAlert2 library -->
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

  <script>
    function deleteProduct(proId) {
        Swal.fire({
            title: 'Remove Product?',
            text: 'This action will permanently delete the product from the store catalog.',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#8860d0',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, delete!',
            background: '#12151c',
            color: '#fff'
        }).then((result) => {
            if (result.isConfirmed) {
                fetch('/admin/products/' + proId, {
                    method: 'DELETE',
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        Swal.fire({
                            title: 'Deleted!',
                            text: 'Product has been removed.',
                            icon: 'success',
                            background: '#12151c',
                            color: '#fff',
                            timer: 1500,
                            showConfirmButton: false
                        });
                        setTimeout(() => location.reload(), 1500);
                    } else {
                        Swal.fire({
                            title: 'Error!',
                            text: 'Failed to remove product: ' + data.message,
                            icon: 'error',
                            background: '#12151c',
                            color: '#fff'
                        });
                    }
                })
                .catch(error => {
                    console.error('Error removing product:', error);
                    Swal.fire({
                        title: 'Error!',
                        text: 'An error occurred while deleting the product.',
                        icon: 'error',
                        background: '#12151c',
                        color: '#fff'
                    });
                });
            }
        });
    }

    function active(id) {
        fetch(`/admin/products/${id}/status`, {
          method: 'POST',
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ payload: id })
        })
        .then(res => res.json())
        .then(data => {
          const isListed = data.updatedData.listed;
          const Toast = Swal.mixin({
            toast: true,
            position: 'top-end',
            showConfirmButton: false,
            timer: 1500,
            timerProgressBar: true,
            background: '#12151c',
            color: '#fff',
            didOpen: (toast) => {
              toast.addEventListener('mouseenter', Swal.stopTimer)
              toast.addEventListener('mouseleave', Swal.resumeTimer)
            }
          });
          Toast.fire({
            icon: 'success',
            title: isListed ? 'Product listed successfully' : 'Product unlisted successfully'
          });
        })
        .catch(error => {
          console.error('Error toggling status:', error);
          const checkbox = document.querySelector(`input[onchange="active('${id}')"]`);
          if (checkbox) checkbox.checked = !checkbox.checked;
          
          Swal.fire({
            title: 'Error!',
            text: 'Failed to update product status.',
            icon: 'error',
            background: '#12151c',
            color: '#fff'
          });
        });
    }
  </script>

  <script>
    const imageRow = document.querySelector('.img-row');
    const name1 = document.querySelector('.name');
    const price1 = document.querySelector('.price');
    const stock1 = document.querySelector('.stock');
    const catName1 = document.querySelector('.category');
    const desc1 = document.querySelector('.description');
    const tags1 = document.querySelector('.tags');
    const gg = document.querySelector('.gg');
    const dname = document.querySelector('.dname');

    function removeP(i, im) {
      const wrap = document.getElementById(`imgBoxWrap${i}`);
      const myForm = document.getElementById('myForm1');
      const peFlag = document.createElement('input');
      peFlag.type = 'hidden'; peFlag.name = `pe${i}`; peFlag.value = 'true';
      const peVal = document.createElement('input');
      peVal.type = 'hidden'; peVal.name = `pe`; peVal.value = im;
      myForm.appendChild(peFlag);
      myForm.appendChild(peVal);

      wrap.innerHTML = `
        <label for="image${i}" class="edit-img-circle empty-state">
          <input type="file" class="file" data-index="${i}" id="image${i}" accept="image/jpeg, image/png, image/jpg" name="images${i}" style="display: none;">
          <img id="im${i}" style="display:none;" src="" alt="">
          <div class="empty-icon"><i class="mdi mdi-plus"></i><span>Add</span></div>
          <div class="edit-img-overlay" style="display:none;"><i class="mdi mdi-camera"></i><span>Change</span></div>
        </label>
        <button type="button" style="display:none;" class="remove-btn-circular" id="removeBtn${i}" onclick="removeNewlyAddedP('${i}')" title="Remove"><i class="mdi mdi-close"></i></button>
      `;
      document.getElementById(`image${i}`).addEventListener('change', () => fileeObj(i));
    }

    function removeNewlyAddedP(i) {
      const wrap = document.getElementById(`imgBoxWrap${i}`);
      const fileInput = document.getElementById(`image${i}`);
      if(fileInput) fileInput.value = '';
      wrap.innerHTML = `
        <label for="image${i}" class="edit-img-circle empty-state">
          <input type="file" class="file" data-index="${i}" id="image${i}" accept="image/jpeg, image/png, image/jpg" name="images${i}" style="display: none;">
          <img id="im${i}" style="display:none;" src="" alt="">
          <div class="empty-icon"><i class="mdi mdi-plus"></i><span>Add</span></div>
          <div class="edit-img-overlay" style="display:none;"><i class="mdi mdi-camera"></i><span>Change</span></div>
        </label>
        <button type="button" style="display:none;" class="remove-btn-circular" id="removeBtn${i}" onclick="removeNewlyAddedP('${i}')" title="Remove"><i class="mdi mdi-close"></i></button>
      `;
      document.getElementById(`image${i}`).addEventListener('change', () => fileeObj(i));
    }

    function openEditProductModal(btn) {
      const id = btn.getAttribute('data-id');
      const name = btn.getAttribute('data-name');
      const images = btn.getAttribute('data-images');
      const stock = btn.getAttribute('data-stock');
      const price = btn.getAttribute('data-price');
      const category = btn.getAttribute('data-category');
      const description = btn.getAttribute('data-description');
      const tags = btn.getAttribute('data-tags');
      edit(images, id, name, stock, price, category, description, tags);
    }

    function edit(image, id, name, stock, price, catName, desc, tags) {
      const myForm = document.getElementById('myForm1');
      const editModal = document.getElementById('editProductModal');
      myForm.action = `/admin/products/${id}`;
      
      const imgs = JSON.parse(image);
      document.querySelector('.name').value = name;
      document.querySelector('.price').value = price;
      document.querySelector('.stock').value = stock;
      document.querySelector('.category').value = catName;
      document.querySelector('.description').value = desc;      
      document.querySelector('.tags').value = tags; 
    
      let html = '';
      for(let i=0; i<3; i++) {
        let im = imgs[i];
        if(im && im !== null && im !== '') {
           let imgSrc = im.startsWith('http') ? im : '/productImage/' + im;
           html += `
            <div id="imgBoxWrap${i}" class="edit-img-wrap">
              <label for="image${i}" class="edit-img-circle">
                <input type="file" class="file" data-index="${i}" id="image${i}" accept="image/jpeg, image/png, image/jpg" name="images${i}" style="display: none;" value="${im}">
                <img id="im${i}" src="${imgSrc}" alt="">
                <div class="edit-img-overlay">
                  <i class="mdi mdi-camera"></i>
                  <span>Change</span>
                </div>
              </label>
              <button type="button" class="remove-btn-circular" onclick="removeP('${i}', '${im}')" title="Remove"><i class="mdi mdi-close"></i></button>
            </div>`;
        } else {
           html += `
            <div id="imgBoxWrap${i}" class="edit-img-wrap">
              <label for="image${i}" class="edit-img-circle empty-state">
                <input type="file" class="file" data-index="${i}" id="image${i}" accept="image/jpeg, image/png, image/jpg" name="images${i}" style="display: none;">
                <img id="im${i}" style="display:none;" src="" alt="">
                <div class="empty-icon"><i class="mdi mdi-plus"></i><span>Add</span></div>
                <div class="edit-img-overlay" style="display:none;">
                  <i class="mdi mdi-camera"></i>
                  <span>Change</span>
                </div>
              </label>
              <button type="button" style="display:none;" class="remove-btn-circular" id="removeBtn${i}" onclick="removeNewlyAddedP('${i}')" title="Remove"><i class="mdi mdi-close"></i></button>
            </div>`;
        }
      }
      document.querySelector('.img-row').innerHTML = html;
      editModal.classList.add('active');

      for (let i = 0; i < 3; i++) {
        const fileInput = document.getElementById(`image${i}`);
        if(fileInput) { fileInput.addEventListener('change', () => fileeObj(i)); }
      }
    }

    function fileeObj(i) {
      let file = document.getElementById(`image${i}`);
      let img = document.getElementById(`im${i}`);
      let label = file.closest('label');
      let emptyIcon = label.querySelector('.empty-icon');
      let overlay = label.querySelector('.edit-img-overlay');
      let removeBtn = document.getElementById(`removeBtn${i}`);
      
      let uploadedFile = file.files ? file.files[0] : null;
      if (uploadedFile) {
        if (['image/png', 'image/jpeg', 'image/jpg', 'image/webp'].includes(uploadedFile.type)) {
          img.src = URL.createObjectURL(uploadedFile);
          img.style.display = 'block';
          label.classList.remove('empty-state');
          if(emptyIcon) emptyIcon.style.display = 'none';
          if(overlay) overlay.style.display = 'flex';
          if(removeBtn) removeBtn.style.display = 'flex';
        } else {
          Swal.fire({
            title: 'Invalid File Type',
            text: 'Please upload only PNG, JPEG, JPG, or WEBP files.',
            icon: 'error',
            background: '#12151c',
            color: '#fff'
          });
          file.value = '';
        }
      }
    }

    function closeEditModal() {
      document.getElementById('editProductModal').classList.remove('active');
    }
  </script>

  <!-- Product Search Script -->
  <script>
  (function() {
    const searchInput = document.getElementById('productSearchInput');
    const searchLoader = document.getElementById('productSearchLoader');
    const searchClear = document.getElementById('productSearchClear');
    const tableBody = document.getElementById('productTableBody');
    const paginationContainer = document.getElementById('productPaginationContainer');
    let debounceTimer = null;
    let currentQuery = '';

    searchInput.addEventListener('input', function() {
      const query = this.value.trim();
      currentQuery = query;
      searchClear.style.display = query.length > 0 ? 'flex' : 'none';
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(() => {
        performSearch(query, 1);
      }, 400);
    });

    searchClear.addEventListener('click', function() {
      searchInput.value = '';
      currentQuery = '';
      searchClear.style.display = 'none';
      performSearch('', 1);
      searchInput.focus();
    });

    function performSearch(query, page) {
      searchLoader.style.display = 'flex';
      fetch(`/admin/products?q=${encodeURIComponent(query)}&page=${page}`, {
        headers: { 'Accept': 'application/json' }
      })
        .then(res => res.json())
        .then(data => {
          renderTable(data.products, data.currentPage);
          renderPagination(data.totalPages, data.currentPage, query);
          searchLoader.style.display = 'none';
        })
        .catch(err => {
          console.error('Product search error:', err);
          searchLoader.style.display = 'none';
        });
    }

    function renderTable(products, currentPage) {
      if (!products || products.length === 0) {
        tableBody.innerHTML = `
          <tr>
            <td colspan="10" style="text-align:center; padding: 4rem 0; border: none;">
              <div class="user-empty-state">
                <i class="ri-search-line" style="font-size: 3rem; opacity: 0.5;"></i>
                <p class="mt-2">No products match your criteria</p>
              </div>
            </td>
          </tr>`;
        return;
      }

      const limit = 5;
      const startIndex = (currentPage - 1) * limit;

      tableBody.innerHTML = products.map((e, i) => {
        const imagesHtml = (e.images || []).map((im, idx) => {
          const src = im.startsWith('http') ? im : '/productImage/' + im;
          return `<div class="product-image-avatar" style="z-index: ${3 - idx};">
            <img src="${src}" alt="product image" onerror="this.src='/images/no-image.png'">
          </div>`;
        }).join('');

        let stockHtml = '';
        const stock = Number(e.stock);
        if (stock === 0) {
          stockHtml = `<span class="stock-badge out-of-stock">Out of Stock</span>`;
        } else if (stock <= 5) {
          stockHtml = `<span class="stock-badge low-stock">Only ${stock} left</span>`;
        } else {
          stockHtml = `<span class="stock-badge in-stock">${stock} Units</span>`;
        }

        const catName = e.category ? e.category.name : 'N/A';
        const imagesJson = JSON.stringify(e.images || []).replace(/'/g, "\\'");
        const descEscaped = (e.description || '').replace(/'/g, "\\'").replace(/\n/g, '\\n').replace(/"/g, '&quot;');
        const tagsEscaped = (e.tags || []).join(', ').replace(/'/g, "\\'").replace(/"/g, '&quot;');
        const nameEscaped = (e.name || '').replace(/'/g, "\\'").replace(/"/g, '&quot;');

        return `
          <tr class="user-row" id="e${e._id}" style="--row-delay: ${(i * 0.05).toFixed(2) + 's'};">
            <td data-label="No." class="user-index">${startIndex + i + 1}</td>
            <td data-label="Product Name" class="font-weight-bold text-white">${e.name}</td>
            <td data-label="Images">
              <div class="product-images-overlap">
                ${imagesHtml}
              </div>
            </td>
            <td data-label="Stock">${stockHtml}</td>
            <td data-label="Price" class="font-weight-bold text-white">₹${Number(e.price).toFixed(2)}</td>
            <td data-label="Created Date"><span class="user-date">${e.createdAt || ''}</span></td>
            <td data-label="Category"><span class="badge badge-outline-secondary" style="border-color: rgba(255,255,255,0.15); color: rgba(255,255,255,0.7);">${catName}</span></td>
            <td data-label="Status">
              <div class="badge badge-outline-success">${e.status || 'Active'}</div>
            </td>
            <td data-label="Listing">
              <label class="user-toggle" title="${e.listed ? 'Unlist Product' : 'List Product'}">
                <input type="checkbox" ${e.listed ? "checked" : ""} onchange="active('${e._id}')">
                <span class="user-toggle-slider"></span>
              </label>
            </td>
            <td data-label="Actions">
              <div class="product-action-group">
                <a href="/admin/products/${e._id}" class="product-action-btn view" title="View Details">
                  <i class="ri-eye-line"></i>
                </a>
                <button 
                  onclick="openEditProductModal(this)" 
                  class="product-action-btn edit" 
                  title="Edit Product"
                  data-id="${e._id}"
                  data-name="${nameEscaped}"
                  data-images="${imagesJson}"
                  data-stock="${e.stock}"
                  data-price="${e.price}"
                  data-category="${catName}"
                  data-description="${descEscaped}"
                  data-tags="${tagsEscaped}"
                >
                  <i class="ri-edit-line"></i>
                </button>
                <button onclick="deleteProduct('${e._id}')" class="product-action-btn delete" title="Delete Product">
                  <i class="ri-delete-bin-line"></i>
                </button>
              </div>
            </td>
          </tr>`;
      }).join('');
    }

    function renderPagination(totalPages, currentPage, query) {
      if (totalPages <= 1) {
        paginationContainer.innerHTML = '';
        return;
      }
      let html = '<div class="pg-container-glass mt-4"><nav aria-label="Page navigation"><ul class="pg-list">';
      
      // Previous Button
      if (currentPage > 1) {
        html += `<li class="pg-item"><a class="pg-link pg-arrow product-page-link" href="#" data-page="${currentPage - 1}" aria-label="Previous"><i class="ri-arrow-left-s-line"></i></a></li>`;
      } else {
        html += `<li class="pg-item disabled"><span class="pg-link pg-arrow"><i class="ri-arrow-left-s-line"></i></span></li>`;
      }

      // Page Numbers
      let startPage = Math.max(1, currentPage - 2);
      let endPage = Math.min(totalPages, currentPage + 2);

      if (startPage > 1) {
        html += `<li class="pg-item"><a class="pg-link product-page-link" href="#" data-page="1">1</a></li>`;
        if (startPage > 2) {
          html += `<li class="pg-item disabled"><span class="pg-link pg-dots">...</span></li>`;
        }
      }

      for (let i = startPage; i <= endPage; i++) {
        html += `<li class="pg-item ${currentPage === i ? 'active' : ''}"><a class="pg-link product-page-link" href="#" data-page="${i}">${i}</a></li>`;
      }

      if (endPage < totalPages) {
        if (endPage < totalPages - 1) {
          html += `<li class="pg-item disabled"><span class="pg-link pg-dots">...</span></li>`;
        }
        html += `<li class="pg-item"><a class="pg-link product-page-link" href="#" data-page="${totalPages}">${totalPages}</a></li>`;
      }

      // Next Button
      if (currentPage < totalPages) {
        html += `<li class="pg-item"><a class="pg-link pg-arrow product-page-link" href="#" data-page="${currentPage + 1}" aria-label="Next"><i class="ri-arrow-right-s-line"></i></a></li>`;
      } else {
        html += `<li class="pg-item disabled"><span class="pg-link pg-arrow"><i class="ri-arrow-right-s-line"></i></span></li>`;
      }

      html += '</ul></nav></div>';
      paginationContainer.innerHTML = html;

      paginationContainer.querySelectorAll('.product-page-link').forEach(link => {
        link.addEventListener('click', function(ev) {
          ev.preventDefault();
          performSearch(query, parseInt(this.dataset.page));
        });
      });
    }
  })();
  </script>

