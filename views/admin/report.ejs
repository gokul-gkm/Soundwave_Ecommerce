<%- include('../layout/adminlayout.ejs') -%>
<link rel="stylesheet" href="/css/admin/report.css">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<div class="container-scroller">
  <%- include('../layout/adminnav.ejs') -%>

  <div class="main-panel">
    <div class="content-wrapper" style="padding: 1.5rem 2.2rem; position: relative;">

      <!-- Ambient glow blobs -->
      <div class="report-blob report-blob-purple"></div>
      <div class="report-blob report-blob-blue"></div>

      <div class="col-12 grid-margin" style="position: relative; z-index: 1;">
        <div class="report-glass">

          <!-- ── Page Header ── -->
          <div class="d-flex align-items-start justify-content-between flex-wrap gap-3 mb-4">
            <div>
              <h3 class="report-page-title">
                <i class="ri-bar-chart-2-line" style="font-size:1.5rem; opacity:0.85;"></i>
                <% if (locals.gg) { %>
                  <%= locals.gg.charAt(0).toUpperCase() + locals.gg.slice(1) %>
                <% } else { %>
                  Sales
                <% } %>
                Report
              </h3>
              <p class="report-page-subtitle">Detailed breakdown of orders &amp; revenue</p>
            </div>

            <!-- Controls -->
            <div class="report-controls">
              <% if (locals.custom) { %>
                <input type="date" id="start" name="start" class="report-date-input" placeholder="Start date">
                <input type="date" id="end" name="end" class="report-date-input" placeholder="End date">
              <% } %>

              <% if (locals.data) { %>
                <form id="myForm" action="/admin/report/download/<%= data %>" method="post" style="display:contents;">
                  <select id="format" name="report" class="report-format-select">
                    <option value="exec">Excel (.xlsx)</option>
                    <option value="pdf">PDF</option>
                  </select>
                  <button type="submit" class="btn-report-download">
                    <i class="ri-download-2-line"></i> Download
                  </button>
                </form>
              <% } %>
            </div>
          </div>

          <!-- Date Range Display (custom mode) -->
          <div id="dateRangeDisplay" style="display:none; margin-bottom: 1rem;">
            <span class="report-date-range">
              <i class="ri-calendar-line"></i>
              <span id="fromDate"></span>
              &nbsp;→&nbsp;
              <span id="toDate"></span>
            </span>
          </div>

          <!-- ── Stats Summary ── -->
          <% if (locals.report && locals.report.length > 0) { %>
            <%
              let totalRevenue = 0;
              locals.report.forEach(o => { totalRevenue += (o.orderAmount || 0); });
              let totalOrders = locals.report.length;
              let avgOrder = totalOrders > 0 ? Math.round(totalRevenue / totalOrders) : 0;
            %>
            <div class="report-stats-grid" id="statsGrid">
              <div class="report-stat-card">
                <i class="ri-shopping-bag-3-line report-stat-icon" style="color:#b794f4;"></i>
                <div class="report-stat-label">Total Orders</div>
                <div class="report-stat-value purple"><%= totalOrders %></div>
              </div>
              <div class="report-stat-card">
                <i class="ri-money-rupee-circle-line report-stat-icon" style="color:#00d25b;"></i>
                <div class="report-stat-label">Total Revenue</div>
                <div class="report-stat-value green">₹<%= totalRevenue.toLocaleString('en-IN') %></div>
              </div>
              <div class="report-stat-card">
                <i class="ri-line-chart-line report-stat-icon" style="color:#ffab00;"></i>
                <div class="report-stat-label">Avg. Order Value</div>
                <div class="report-stat-value gold">₹<%= avgOrder.toLocaleString('en-IN') %></div>
              </div>
            </div>
          <% } %>

          <hr class="report-divider">

          <!-- ── Orders Table ── -->
          <div class="report-table-wrapper">
            <table class="report-table">
              <thead>
                <tr>
                  <th>#</th>
                  <th>Order ID</th>
                  <th>Customer</th>
                  <th>Date</th>
                  <th>Amount</th>
                  <th>Payment</th>
                </tr>
              </thead>
              <tbody id="tb">
                <% if (locals.report && locals.report.length > 0) { %>
                  <% locals.report.forEach((e, i) => { %>
                    <tr class="report-row" style="--row-delay: <%= (i * 0.04).toFixed(2) %>s;">
                      <td class="report-idx"><%= i + 1 %></td>
                      <td class="report-order-id" title="<%= e._id %>">
                        <%= e._id.toString().slice(-10) %>...
                      </td>
                      <td class="report-name"><%= e.deliveryAddress ? e.deliveryAddress.name : '—' %></td>
                      <td class="report-date-cell">
                        <%= e.orderDate ? e.orderDate.toString().split(' ').slice(0,4).join(' ') : '—' %>
                      </td>
                      <td class="report-amount"><%= (e.orderAmount || 0).toLocaleString('en-IN') %></td>
                      <td>
                        <%
                          let pm = (e.peyment || '').toLowerCase();
                          let pmClass = pm.includes('razorpay') ? 'razorpay' : pm.includes('cod') ? 'cod' : pm.includes('wallet') ? 'wallet' : 'default';
                        %>
                        <span class="report-payment-badge <%= pmClass %>">
                          <%= e.peyment || '—' %>
                        </span>
                      </td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr>
                    <td colspan="6" style="border: none; background: transparent; padding: 0;">
                      <div class="report-empty">
                        <i class="ri-file-chart-line"></i>
                        <p>No orders found for this period.<br>
                          <% if (locals.custom) { %>
                            Select a date range above to generate your report.
                          <% } else { %>
                            Try a different report period.
                          <% } %>
                        </p>
                      </div>
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>

        </div><!-- /report-glass -->
      </div>
    </div>
  </div><!-- /main-panel -->
</div><!-- /container-scroller -->

<script>
  (() => {
    const startEl   = document.getElementById('start');
    const endEl     = document.getElementById('end');
    const tb        = document.getElementById('tb');
    const fromDate  = document.getElementById('fromDate');
    const toDate    = document.getElementById('toDate');
    const rangeDisp = document.getElementById('dateRangeDisplay');
    const statsGrid = document.getElementById('statsGrid');
    const myForm    = document.getElementById('myForm');

    function paymentClass(pm) {
      if (!pm) return 'default';
      const p = pm.toLowerCase();
      if (p.includes('razorpay')) return 'razorpay';
      if (p.includes('cod'))      return 'cod';
      if (p.includes('wallet'))   return 'wallet';
      return 'default';
    }

    function formatINR(n) {
      return Number(n || 0).toLocaleString('en-IN');
    }

    function renderRows(data) {
      if (!data || data.length === 0) {
        tb.innerHTML = `<tr><td colspan="6" style="border:none;background:transparent;padding:0;">
          <div class="report-empty">
            <i class="ri-file-chart-line"></i>
            <p>No orders found for this date range.</p>
          </div></td></tr>`;
        if (statsGrid) statsGrid.style.display = 'none';
        return;
      }

      // Recalculate stats
      const totalRevenue = data.reduce((s, e) => s + (e.orderAmount || 0), 0);
      const totalOrders  = data.length;
      const avgOrder     = totalOrders > 0 ? Math.round(totalRevenue / totalOrders) : 0;

      if (statsGrid) {
        statsGrid.style.display = 'grid';
        statsGrid.innerHTML = `
          <div class="report-stat-card">
            <i class="ri-shopping-bag-3-line report-stat-icon" style="color:#b794f4;"></i>
            <div class="report-stat-label">Total Orders</div>
            <div class="report-stat-value purple">${totalOrders}</div>
          </div>
          <div class="report-stat-card">
            <i class="ri-money-rupee-circle-line report-stat-icon" style="color:#00d25b;"></i>
            <div class="report-stat-label">Total Revenue</div>
            <div class="report-stat-value green">₹${formatINR(totalRevenue)}</div>
          </div>
          <div class="report-stat-card">
            <i class="ri-line-chart-line report-stat-icon" style="color:#ffab00;"></i>
            <div class="report-stat-label">Avg. Order Value</div>
            <div class="report-stat-value gold">₹${formatINR(avgOrder)}</div>
          </div>
        `;
      }

      tb.innerHTML = data.map((e, i) => {
        const pmClass = paymentClass(e.peyment);
        const dateStr = e.orderDate
          ? new Date(e.orderDate).toString().split(' ').slice(0,4).join(' ')
          : '—';
        const orderId = e._id ? String(e._id).slice(-10) + '...' : '—';
        const name    = e.deliveryAddress ? e.deliveryAddress.name : '—';
        return `
          <tr class="report-row" style="--row-delay:${(i * 0.04).toFixed(2)}s;">
            <td class="report-idx">${i + 1}</td>
            <td class="report-order-id" title="${e._id}">${orderId}</td>
            <td class="report-name">${name}</td>
            <td class="report-date-cell">${dateStr}</td>
            <td class="report-amount">${formatINR(e.orderAmount)}</td>
            <td><span class="report-payment-badge ${pmClass}">${e.peyment || '—'}</span></td>
          </tr>`;
      }).join('');
    }

    function change() {
      if (!startEl || !endEl) return;
      if (startEl.value && endEl.value) {
        fetch('/admin/report', {
          method: 'put',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ start: startEl.value, end: endEl.value })
        })
        .then(r => r.json())
        .then(resp => {
          if (rangeDisp) {
            fromDate.textContent = startEl.value;
            toDate.textContent   = endEl.value;
            rangeDisp.style.display = 'block';
          }
          renderRows(resp.data);
          if (myForm) {
            myForm.action = `/admin/report/download/custom?start=${startEl.value}&&end=${endEl.value}`;
          }
        })
        .catch(err => console.error(err));
      }
    }

    if (startEl) startEl.addEventListener('change', change);
    if (endEl)   endEl.addEventListener('change', change);

    // Format select changes form submit type
    const formatSelect = document.getElementById('format');
    if (formatSelect && myForm) {
      formatSelect.addEventListener('change', function() {
        // action is already set with the correct format parameter via "name" of select
      });
    }
  })();
</script>

<script src="/vendors/js/vendor.bundle.base.js"></script>
<script src="/js/off-canvas.js"></script>
<script src="/js/hoverable-collapse.js"></script>
<script src="/js/misc.js"></script>
<script src="/js/settings.js"></script>

</body>
</html>
