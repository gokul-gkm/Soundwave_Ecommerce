<%- include('../layout/adminlayout.ejs') -%>
<link rel="stylesheet" href="/css/admin/userList.css">
<div class="container-scroller">
  <%- include('../layout/adminnav.ejs') -%>
  <div class="main-panel">
    <div class="content-wrapper" style="padding: 1.5rem 2.2rem;">
      <div class="row">
        <!-- Background Blurs -->
        <div class="circle position-fixed" style="background-color: rebeccapurple; filter: blur(140px); width: 14rem; height: 11rem; border-radius: 50%; right: 5rem; top: 15rem; z-index: 0; opacity: 0.5; pointer-events: none;"></div>
        <div class="circle position-fixed" style="background-color: rgba(0, 0, 255, 0.4); filter: blur(140px); width: 14rem; height: 11rem; border-radius: 50%; left: 18rem; top: 8rem; z-index: 0; opacity: 0.5; pointer-events: none;"></div>

        <div class="col-12 grid-margin" style="position: relative; z-index: 1;">
          <div class="user-container-glass">
            <div class="d-flex align-items-center justify-content-between mb-4">
              <div>
                <h3 class="user-page-title">User Management</h3>
                <p class="user-page-subtitle text-muted">Manage client accounts and access status</p>
              </div>
            </div>

            <!-- Search Bar -->
            <div class="user-search-wrapper mb-4">
              <div class="user-search-box">
                <i class="ri-search-line user-search-icon"></i>
                <input
                  type="text"
                  id="userSearchInput"
                  class="user-search-input"
                  placeholder="Search users by name or email..."
                  autocomplete="off"
                />
                <div class="user-search-loader" id="userSearchLoader" style="display:none;">
                  <div class="user-search-spinner"></div>
                </div>
                <button class="user-search-clear" id="userSearchClear" style="display:none;" title="Clear search">
                  <i class="ri-close-line"></i>
                </button>
              </div>
            </div>

            <div class="table-responsive">
              <table class="user-custom-table">
                <thead>
                  <tr>
                    <th style="width: 70px;">No</th>
                    <th>User Details</th>
                    <th>Status</th>
                    <th>Joined Date</th>
                    <th class="text-center" style="width: 120px;">Access</th>
                    <th class="text-end" style="width: 100px;">Actions</th>
                  </tr>
                </thead>
                <tbody id="userTableBody">
                  <% locals.users.forEach((e, i) => { %>
                  <tr class="user-row" style="--row-delay: <%= (i * 0.05).toFixed(2) + 's' %>;">
                    <td class="user-index"><%= i + 1 %></td>
                    <td>
                      <div class="user-info-cell">
                        <span class="user-name" id="name<%= e._id %>"><%= e.name %></span>
                        <span class="user-email text-muted" id="email<%= e._id %>"><%= e.email %></span>
                      </div>
                    </td>
                    <td>
                      <span id="status<%= e._id %>" class="user-status-badge <%= e.is_block ? 'blocked' : 'active' %>">
                        <%= e.is_block ? 'Blocked' : 'Active' %>
                      </span>
                    </td>
                    <td>
                      <span class="user-date"><%= e.date ? e.date : '04 Dec 2019' %></span>
                    </td>
                    <td class="text-center">
                      <label class="user-toggle" title="<%= e.is_block ? 'Unblock User' : 'Block User' %>">
                        <input type="checkbox" <%= !e.is_block ? "checked" : "" %> onchange="toggleBlock('<%= e._id %>')">
                        <span class="user-toggle-slider"></span>
                      </label>
                    </td>
                    <td class="text-end">
                      <button onclick="confirmDeletion('<%= e._id %>')" class="user-icon-btn delete" title="Remove User">
                        <i class="ri-delete-bin-line"></i>
                      </button>
                    </td>
                  </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>

            <div id="userPaginationContainer" class="mt-4">
              <%- include('../layout/pagination.ejs') -%>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
  function confirmDeletion(userId) {
    Swal.fire({
      title: "Remove User?",
      text: "This action will permanently delete the user account from the system.",
      icon: "warning",
      showCancelButton: true,
      confirmButtonColor: "#8860d0",
      cancelButtonColor: "#d33",
      confirmButtonText: "Yes, delete!",
      background: '#12151c',
      color: '#fff'
    }).then((result) => {
      if (result.isConfirmed) {
        fetch('/admin/users/' + userId, { method: 'DELETE' })
          .then(res => res.json())
          .then(data => {
            if (data.success) {
              Swal.fire({
                title: "Deleted!",
                text: "User has been removed.",
                icon: "success",
                background: '#12151c',
                color: '#fff',
                timer: 1500,
                showConfirmButton: false
              });
              setTimeout(() => location.reload(), 1500);
            }
          })
          .catch(err => console.error('Error:', err));
      }
    });
  }

  function toggleBlock(id) {
    const statusBadge = document.getElementById(`status${id}`);
    fetch(`/admin/users/${id}/block`, {
      method: 'POST',
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ payload: id })
    })
    .then(res => res.json())
    .then(data => {
      const isBlocked = data.updatedData.is_block;
      statusBadge.textContent = isBlocked ? 'Blocked' : 'Active';
      statusBadge.className = `user-status-badge ${isBlocked ? 'blocked' : 'active'}`;
    })
    .catch(err => console.error('Error:', err));
  }

  // User Search Logic
  (function() {
    const searchInput = document.getElementById('userSearchInput');
    const searchLoader = document.getElementById('userSearchLoader');
    const searchClear = document.getElementById('userSearchClear');
    const tableBody = document.getElementById('userTableBody');
    const paginationContainer = document.getElementById('userPaginationContainer');
    let debounceTimer = null;

    searchInput.addEventListener('input', function() {
      const query = this.value.trim();
      searchClear.style.display = query.length > 0 ? 'flex' : 'none';
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(() => performSearch(query, 1), 400);
    });

    searchClear.addEventListener('click', function() {
      searchInput.value = '';
      searchClear.style.display = 'none';
      performSearch('', 1);
      searchInput.focus();
    });

    function performSearch(query, page) {
      searchLoader.style.display = 'flex';
      fetch(`/admin/users?q=${encodeURIComponent(query)}&page=${page}`, {
        headers: { 'Accept': 'application/json' }
      })
      .then(res => res.json())
      .then(data => {
        renderTable(data.users, data.currentPage);
        paginationUpdate(data.totalPages, data.currentPage, query);
        searchLoader.style.display = 'none';
      })
      .catch(err => {
        console.error('Search error:', err);
        searchLoader.style.display = 'none';
      });
    }

    function renderTable(users, currentPage) {
      if (!users || users.length === 0) {
        tableBody.innerHTML = `
          <tr><td colspan="6" style="text-align:center; padding: 4rem 0;">
            <div class="user-empty-state">
              <i class="ri-user-search-line"></i>
              <p>No users match your criteria</p>
            </div>
          </td></tr>`;
        return;
      }
      const limit = 4;
      const startIndex = (currentPage - 1) * limit;
      tableBody.innerHTML = users.map((e, i) => `
        <tr class="user-row" style="--row-delay: ${(i * 0.05).toFixed(2) + 's'};">
          <td class="user-index">${startIndex + i + 1}</td>
          <td>
            <div class="user-info-cell">
              <span class="user-name" id="name${e._id}">${e.name}</span>
              <span class="user-email text-muted">${e.email}</span>
            </div>
          </td>
          <td>
            <span id="status${e._id}" class="user-status-badge ${e.is_block ? 'blocked' : 'active'}">
              ${e.is_block ? 'Blocked' : 'Active'}
            </span>
          </td>
          <td><span class="user-date">${e.date ? e.date : '04 Dec 2019'}</span></td>
          <td class="text-center">
            <label class="user-toggle">
              <input type="checkbox" ${!e.is_block ? "checked" : ""} onchange="toggleBlock('${e._id}')">
              <span class="user-toggle-slider"></span>
            </label>
          </td>
          <td class="text-end">
            <button onclick="confirmDeletion('${e._id}')" class="user-icon-btn delete">
              <i class="ri-delete-bin-line"></i>
            </button>
          </td>
        </tr>
      `).join('');
    }

    function paginationUpdate(totalPages, currentPage, query) {
      if(totalPages > 1) { /* Dynamic pagination logic here */ }
    }
  })();
</script>

<script src="/vendors/js/vendor.bundle.base.js"></script>
<script src="/js/off-canvas.js"></script>
<script src="/js/hoverable-collapse.js"></script>
<script src="/js/misc.js"></script>
<script src="/js/settings.js"></script>
<script src="/js/todolist.js"></script>
</body>
</html>