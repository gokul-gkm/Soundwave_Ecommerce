  <script src="/js/dashboard.js"></script>
  <style>
    body::-webkit-scrollbar {
      width: 0;
    }

    body {
      overflow: hidden !important;
    }

    .container-scroller {
      overflow: hidden;
    }

    input[type="number"]::-webkit-inner-spin-button,
    input[type="number"]::-webkit-outer-spin-button {
      -webkit-appearance: none !important;
    }
    /* User Search Styles */
    .user-search-wrapper {
      position: relative;
    }

    .user-search-box {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      padding: 0.55rem 1rem;
      border-radius: 12px;
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid rgba(255, 255, 255, 0.1);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      transition: border-color 0.3s ease, box-shadow 0.3s ease, background 0.3s ease;
    }

    .user-search-box:focus-within {
      border-color: rgba(136, 96, 208, 0.6);
      box-shadow: 0 0 0 3px rgba(136, 96, 208, 0.12), 0 4px 20px rgba(136, 96, 208, 0.08);
      background: rgba(255, 255, 255, 0.09);
    }

    .user-search-icon {
      color: rgba(255, 255, 255, 0.35);
      flex-shrink: 0;
      transition: color 0.3s ease;
    }

    .user-search-box:focus-within .user-search-icon {
      color: rgba(136, 96, 208, 0.8);
    }

    .user-search-input {
      flex: 1;
      border: none;
      outline: none;
      background: transparent;
      font-size: 0.92rem;
      color: inherit;
      letter-spacing: 0.01em;
    }

    .user-search-input::placeholder {
      color: rgba(255, 255, 255, 0.3);
      font-weight: 300;
    }

    .user-search-input:focus::placeholder {
      color: rgba(255, 255, 255, 0.18);
    }

    .user-search-clear {
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(255, 255, 255, 0.08);
      border: none;
      border-radius: 50%;
      width: 26px;
      height: 26px;
      cursor: pointer;
      color: rgba(255, 255, 255, 0.45);
      transition: all 0.2s ease;
      flex-shrink: 0;
      padding: 0;
    }

    .user-search-clear:hover {
      background: rgba(215, 38, 36, 0.2);
      color: #d72624;
    }

    .user-search-loader {
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .user-search-spinner {
      width: 18px;
      height: 18px;
      border: 2px solid rgba(136, 96, 208, 0.2);
      border-top-color: rgba(136, 96, 208, 0.8);
      border-radius: 50%;
      animation: spinUserSearch 0.6s linear infinite;
    }

    @keyframes spinUserSearch {
      to { transform: rotate(360deg); }
    }

    @keyframes fadeInUserRow {
      from { opacity: 0; transform: translateY(6px); }
      to { opacity: 1; transform: translateY(0); }
    }
  </style>

  <script src="https://cdn.jsdelivr.net/npm/locomotive-scroll@3.5.4/dist/locomotive-scroll.js"></script>

  <script src="https://unpkg.com/@studio-freight/lenis@1.0.33/dist/lenis.min.js"></script>

  <script src="/js/base.js"></script>

  </body>

  </html>