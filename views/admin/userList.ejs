<%- include('../layout/adminlayout.ejs') -%>
  <div class="container-scroller">

    <%- include('../layout/adminnav.ejs') -%>

      <div class="main-panel">
        <div class="content-wrapper">
          <div class="row ">
            <div class="circle position-absolute " style="background-color: rebeccapurple;
            filter: blur(136px);
            width: 13rem;
            height: 10rem;
            border-radius: 50%;
            transform: translate(57rem, 23rem);"></div>
            <div class="circle position-absolute " style="background-color: rgba(0, 0, 255, 0.589);
            filter: blur(136px);
            width: 13rem;
            height: 10rem;
            border-radius: 50%;
         "></div>
            <div class="col-12 grid-margin">
              <div class="card " style="height: 80vh; border-radius: 15px; box-shadow: 0 0 0 0; border: 0;">
                <div class="card" style="border-radius: 15px; box-shadow: 0 0 0 0; border: 0;">
                  <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between ">
                      <h4 class="card-title">Users</h4>
                    </div>

                    <!-- Search Bar -->
                    <div class="user-search-wrapper" style="margin-bottom: 1.2rem;">
                      <div class="user-search-box">
                        <svg class="user-search-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <circle cx="11" cy="11" r="8"></circle>
                          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                        </svg>
                        <input
                          type="text"
                          id="userSearchInput"
                          class="user-search-input"
                          placeholder="Search users by name or email..."
                          autocomplete="off"
                        />
                        <div class="user-search-loader" id="userSearchLoader" style="display:none;">
                          <div class="user-search-spinner"></div>
                        </div>
                        <button class="user-search-clear" id="userSearchClear" style="display:none;" title="Clear search">
                          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                          </svg>
                        </button>
                      </div>
                    </div>
                    <div class="table-responsive">
                      <table class="table">
                        <thead>
                          <tr>
                            <th>
                              No
                            </th>
                            <th> Client Name </th>
                            <th> E-mail </th>

                            <th> Status </th>
                            <th> Date Joined</th>
                            <th> Block </th>
                            <th>Action</th>
                          </tr>
                        </thead>
                        <tbody id="userTableBody">
                          <% locals.users.forEach((e,i)=>{%>

                            <tr>
                              <td>
                                <%= i+1 %>
                              </td>
                              <td>

                                <span class="pl-2 " id="name<%= e._id  %>">
                                  <%=e.name %>
                                </span>
                              </td>
                              <td id="email<%= e._id  %>">
                                <%=e.email %>
                              </td>

                              <td id="status<%=e._id  %>" class=" <%= e.is_block?'text-danger':' text-success'  %>">
                                <%= e.is_block===false?'true':'false' %>
                              </td>
                              
                              <td>
                                <%= e.date?e.date:'04 Dec 2019' %>
                              </td>
                              <td>
                                <div onclick="is_block('<%= e._id %>','<%= e.is_block%>')" id="b<%=e.id  %>" style="cursor: pointer;"
                                  class="badge  <%= e.is_block === false ? 'badge-outline-success' : 'badge-outline-danger' %>">
                                  <%= e.is_block ? 'non-block' : 'block' %>
                                </div>
                              </td>

                              <td>
                                <a href="#" onclick="deleteUser('<%= e._id %>')"  style="cursor: pointer; background-color: red;"
                                  class="badge btn  text-white ">
                                  remove
                                </a >
                              </td>
                            </tr>
                            <%}) %>
                        </tbody>
                      </table>
                    </div>

                    <div id="userPaginationContainer">
                      <%- include('../layout/pagination.ejs') -%>
                    </div>

                  </div>
                </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
  </div>

  <script>
    function deleteUser(userId) {
        
        if (confirm('Are you sure you want to remove this user?')) {

            fetch('/admin/users/' + userId, {
                method: 'DELETE',
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {                    
                    alert('User removed successfully');                  
                    location.reload();
                } else {
                    alert('Failed to remove user: ' + data.message);
                }
            })
            .catch(error => console.error('Error removing user:', error));
        }
    }
</script>



<script>
function is_block(id, block) {
  const name = document.getElementById(`name${id}`)
  const email = document.getElementById(`email${id}`)
  const status = document.getElementById(`status${id}`)
  const btn = document.getElementById(`b${id}`)

  fetch(`/admin/users/${id}/block`, {
    method: 'POST',
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ payload: id, block })

  }).then(res => res.json()).then(data => {

      status.textContent=data.updatedData.is_block?false:true
    
      if(data.updatedData.is_block){

        status.classList.remove("text-success");
        status.classList.add("text-danger");
        btn.style.borderColor='#d72624'
        btn.style.color='#d72624'
        btn.textContent="non-block"   
      }else{

        status.classList.remove("text-danger");
        status.classList.add("text-success");      
        btn.style.borderColor='#00b032'
        btn.style.color='#00b032'        
        btn.textContent="block"
      } 
  })
}
  </script>

  <!-- User Search Script -->
  <script>
  (function() {
    const searchInput = document.getElementById('userSearchInput');
    const searchLoader = document.getElementById('userSearchLoader');
    const searchClear = document.getElementById('userSearchClear');
    const tableBody = document.getElementById('userTableBody');
    const paginationContainer = document.getElementById('userPaginationContainer');
    let debounceTimer = null;
    let currentQuery = '';

    searchInput.addEventListener('input', function() {
      const query = this.value.trim();
      currentQuery = query;
      searchClear.style.display = query.length > 0 ? 'flex' : 'none';
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(() => {
        performSearch(query, 1);
      }, 400);
    });

    searchClear.addEventListener('click', function() {
      searchInput.value = '';
      currentQuery = '';
      searchClear.style.display = 'none';
      performSearch('', 1);
      searchInput.focus();
    });

    function performSearch(query, page) {
      searchLoader.style.display = 'flex';
      fetch(`/admin/users?q=${encodeURIComponent(query)}&page=${page}`, {
        headers: { 'Accept': 'application/json' }
      })
        .then(res => res.json())
        .then(data => {
          renderTable(data.users, data.currentPage);
          renderPagination(data.totalPages, data.currentPage, query);
          searchLoader.style.display = 'none';
        })
        .catch(err => {
          console.error('User search error:', err);
          searchLoader.style.display = 'none';
        });
    }

    function renderTable(users, currentPage) {
      if (!users || users.length === 0) {
        tableBody.innerHTML = `
          <tr>
            <td colspan="7" style="text-align:center; padding: 2.5rem 0;">
              <div style="display:flex; flex-direction:column; align-items:center; gap:0.5rem; opacity:0.6;">
                <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="opacity:0.4;">
                  <circle cx="11" cy="11" r="8"></circle>
                  <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                  <line x1="8" y1="11" x2="14" y2="11"></line>
                </svg>
                <span style="font-size:0.95rem;">No users found</span>
              </div>
            </td>
          </tr>`;
        return;
      }

      const limit = 4;
      const startIndex = (currentPage - 1) * limit;

      tableBody.innerHTML = users.map((e, i) => `
        <tr style="animation: fadeInUserRow 0.25s ease ${i * 0.04}s both;">
          <td>${startIndex + i + 1}</td>
          <td>
            <span class="pl-2" id="name${e._id}">${e.name}</span>
          </td>
          <td id="email${e._id}">${e.email}</td>
          <td id="status${e._id}" class="${e.is_block ? 'text-danger' : 'text-success'}">
            ${e.is_block === false ? 'true' : 'false'}
          </td>
          <td>
            ${e.date ? e.date : '04 Dec 2019'}
          </td>
          <td>
            <div onclick="is_block('${e._id}','${e.is_block}')" id="b${e._id}" style="cursor: pointer;"
              class="badge ${e.is_block === false ? 'badge-outline-success' : 'badge-outline-danger'}">
              ${e.is_block ? 'non-block' : 'block'}
            </div>
          </td>
          <td>
            <a href="#" onclick="deleteUser('${e._id}')" style="cursor: pointer; background-color: red;"
              class="badge btn text-white">
              remove
            </a>
          </td>
        </tr>
      `).join('');
    }

    function renderPagination(totalPages, currentPage, query) {
      if (totalPages <= 1) {
        paginationContainer.innerHTML = '';
        return;
      }
      let html = '<nav aria-label="Page navigation"><ul class="pagination justify-content-center">';
      if (currentPage > 1) {
        html += `<li class="page-item"><a class="page-link user-page-link" href="#" data-page="${currentPage - 1}" aria-label="Previous"><span aria-hidden="true">&laquo;</span></a></li>`;
      }
      for (let i = 1; i <= totalPages; i++) {
        html += `<li class="page-item ${currentPage === i ? 'active' : ''}"><a class="page-link user-page-link" href="#" data-page="${i}">${i}</a></li>`;
      }
      if (currentPage < totalPages) {
        html += `<li class="page-item"><a class="page-link user-page-link" href="#" data-page="${currentPage + 1}" aria-label="Next"><span aria-hidden="true">&raquo;</span></a></li>`;
      }
      html += '</ul></nav>';
      paginationContainer.innerHTML = html;

      paginationContainer.querySelectorAll('.user-page-link').forEach(link => {
        link.addEventListener('click', function(ev) {
          ev.preventDefault();
          performSearch(query, parseInt(this.dataset.page));
        });
      });
    }
  })();
  </script>
