<%- include('../layout/adminlayout.ejs') -%>
<link rel="stylesheet" href="/css/admin/orderDets.css">
<div class="container-scroller">
  <%- include('../layout/adminnav.ejs') -%>
  <div class="main-panel">
    <div class="content-wrapper" style="padding: 1.5rem 2.2rem;">
      <div class="row">
        <!-- Background Blurs -->
        <div class="circle position-fixed" style="background-color: rebeccapurple; filter: blur(140px); width: 14rem; height: 11rem; border-radius: 50%; right: 5rem; top: 15rem; z-index: 0; opacity: 0.5; pointer-events: none;"></div>
        <div class="circle position-fixed" style="background-color: rgba(0, 0, 255, 0.4); filter: blur(140px); width: 14rem; height: 11rem; border-radius: 50%; left: 18rem; top: 8rem; z-index: 0; opacity: 0.5; pointer-events: none;"></div>

        <div class="col-12 grid-margin" style="position: relative; z-index: 1;">
          <div class="order-container-glass">
            <div class="d-flex align-items-center justify-content-between mb-4">
              <div>
                <h3 class="order-page-title">Order Management</h3>
                <p class="order-page-subtitle text-muted">Track and process customer orders</p>
              </div>
            </div>

            <!-- Search Bar -->
            <div class="order-search-wrapper mb-4">
              <div class="order-search-box">
                <i class="ri-search-line order-search-icon"></i>
                <input
                  type="text"
                  id="orderSearchInput"
                  class="order-search-input"
                  placeholder="Search orders by name, ID or status..."
                  autocomplete="off"
                />
                <div class="order-search-loader" id="orderSearchLoader" style="display:none;">
                  <div class="order-search-spinner"></div>
                </div>
                <button class="order-search-clear" id="orderSearchClear" style="display:none;" title="Clear search">
                  <i class="ri-close-line"></i>
                </button>
              </div>
            </div>

            <div class="table-responsive">
              <table class="order-custom-table">
                <thead>
                  <tr>
                    <th style="width: 70px;">No</th>
                    <th>Customer</th>
                    <th>Total</th>
                    <th class="d-none d-md-table-cell">Method</th>
                    <th class="d-none d-lg-table-cell">Date</th>
                    <th>Status</th>
                    <th class="text-end" style="width: 140px;">Actions</th>
                  </tr>
                </thead>
                <tbody id="orderTableBody">
                  <% locals.orderList.forEach((elem, i) => { %>
                  <tr class="order-row" id="c<%= elem._id %>" style="--row-delay: <%= (i * 0.05).toFixed(2) + 's' %>;">
                    <td class="order-index"><%= i + 1 %></td>
                    <td>
                      <div class="order-client-cell">
                        <span class="order-client-name"><%= elem.userId ? elem.userId.name : 'Guest User' %></span>
                        <span class="order-id d-block d-md-none text-muted" style="font-size: 0.75rem;">#<%= elem._id.toString().slice(-6).toUpperCase() %></span>
                      </div>
                    </td>
                    <td>
                      <span class="order-amount">₹<%= elem.orderAmount.toFixed(2) %></span>
                    </td>
                    <td class="d-none d-md-table-cell">
                      <span class="order-payment-mode"><%= elem.peyment %></span>
                    </td>
                    <td class="d-none d-lg-table-cell">
                      <span class="order-date"><%= elem.orderDate.toString().split(' ').slice(0,4).join(' ') %></span>
                    </td>
                    <td>
                      <div class="order-status-badge <%= elem.orderStatus.toLowerCase().replace(' ', '-') %>">
                        <%= elem.orderStatus %>
                      </div>
                    </td>
                    <td class="text-end">
                      <div class="d-flex justify-content-center align-items-center gap-3">
                        <a href="/admin/orders/<%= elem._id %>" class="order-icon-btn info" title="Order Details">
                          <i class="ri-eye-line"></i>
                        </a>
                        <button onclick="confirmRemoval('<%= elem._id %>')" class="order-icon-btn delete" title="Delete Order">
                          <i class="ri-delete-bin-line"></i>
                        </button>
                      </div>
                    </td>
                  </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>

            <div id="orderPaginationContainer" class="mt-4">
              <%- include('../layout/pagination.ejs') -%>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
  function confirmRemoval(id) {
    Swal.fire({
      title: "Delete Order?",
      text: "This action cannot be undone. Make sure you want to remove this record.",
      icon: "warning",
      showCancelButton: true,
      confirmButtonColor: "#8860d0",
      cancelButtonColor: "#d33",
      confirmButtonText: "Yes, delete it!",
      background: '#12151c',
      color: '#fff'
    }).then((result) => {
      if (result.isConfirmed) {
        fetch(`/admin/orders/${id}`, { method: 'DELETE' })
          .then(res => res.json())
          .then(data => {
            if (data.succes) {
              const row = document.getElementById(`c${id}`);
              row.style.opacity = '0';
              row.style.transform = 'translateX(20px)';
              setTimeout(() => row.remove(), 300);
              Swal.fire({
                title: "Deleted!",
                text: "Order record removed.",
                icon: "success",
                timer: 1000,
                showConfirmButton: false,
                background: '#12151c',
                color: '#fff'
              });
            }
          })
          .catch(err => console.error('Error:', err));
      }
    });
  }

  // Order Search Logic
  (function() {
    const searchInput = document.getElementById('orderSearchInput');
    const searchLoader = document.getElementById('orderSearchLoader');
    const searchClear = document.getElementById('orderSearchClear');
    const tableBody = document.getElementById('orderTableBody');
    const paginationContainer = document.getElementById('orderPaginationContainer');
    let debounceTimer = null;

    searchInput.addEventListener('input', function() {
      const query = this.value.trim();
      searchClear.style.display = query.length > 0 ? 'flex' : 'none';
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(() => performSearch(query, 1), 400);
    });

    searchClear.addEventListener('click', function() {
      searchInput.value = '';
      searchClear.style.display = 'none';
      performSearch('', 1);
      searchInput.focus();
    });

    function performSearch(query, page) {
      searchLoader.style.display = 'flex';
      fetch(`/admin/orders?q=${encodeURIComponent(query)}&page=${page}`, {
        headers: { 'Accept': 'application/json' }
      })
      .then(res => res.json())
      .then(data => {
        renderTable(data.orderList, data.currentPage);
        // pagination rerender logic if needed
        searchLoader.style.display = 'none';
      })
      .catch(err => {
        console.error('Search error:', err);
        searchLoader.style.display = 'none';
      });
    }

    function renderTable(orders, currentPage) {
      if (!orders || orders.length === 0) {
        tableBody.innerHTML = `
          <tr><td colspan="7" style="text-align:center; padding: 4rem 0;">
            <div class="order-empty-state">
              <i class="ri-inbox-archive-line"></i>
              <p>No orders matched your search</p>
            </div>
          </td></tr>`;
        return;
      }
      const limit = 5;
      const startIndex = (currentPage - 1) * limit;
      tableBody.innerHTML = orders.map((elem, i) => {
        const clientName = elem.userId ? elem.userId.name : 'Guest User';
        const orderDateStr = new Date(elem.orderDate).toString().split(' ').slice(0,4).join(' ');
        const statusClass = elem.orderStatus.toLowerCase().replace(' ', '-');
        
        return `
          <tr class="order-row" id="c${elem._id}" style="--row-delay: ${(i * 0.05).toFixed(2) + 's'};">
            <td class="order-index">${startIndex + i + 1}</td>
            <td>
              <div class="order-client-cell">
                <span class="order-client-name">${clientName}</span>
                <span class="order-id d-block d-md-none text-muted" style="font-size: 0.75rem;">#${elem._id.toString().slice(-6).toUpperCase()}</span>
              </div>
            </td>
            <td><span class="order-amount">₹${elem.orderAmount.toFixed(2)}</span></td>
            <td class="d-none d-md-table-cell"><span class="order-payment-mode">${elem.peyment}</span></td>
            <td class="d-none d-lg-table-cell"><span class="order-date">${orderDateStr}</span></td>
            <td><div class="order-status-badge ${statusClass}">${elem.orderStatus}</div></td>
            <td class="text-end">
              <div class="d-flex justify-content-end align-items-center gap-3">
                <a href="/admin/orders/${elem._id}" class="order-icon-btn info"><i class="ri-eye-line"></i></a>
                <button onclick="confirmRemoval('${elem._id}')" class="order-icon-btn delete"><i class="ri-delete-bin-line"></i></button>
              </div>
            </td>
          </tr>`;
      }).join('');
    }
  })();
</script>


<script src="/vendors/js/vendor.bundle.base.js"></script>
<script src="/js/off-canvas.js"></script>
<script src="/js/hoverable-collapse.js"></script>
<script src="/js/misc.js"></script>
<script src="/js/settings.js"></script>
<script src="/js/todolist.js"></script>
</body>
</html>