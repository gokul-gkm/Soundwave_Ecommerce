  <script src="/js/settings.js"></script>
  <script src="/js/todolist.js"></script>
  <script src="/js/dashboard.js"></script>
  <style>
    body::-webkit-scrollbar {
      width: 0;
    }

    body {
      overflow: hidden !important;
    }

    .container-scroller {
      overflow: hidden;
    }

    input[type="number"]::-webkit-inner-spin-button,
    input[type="number"]::-webkit-outer-spin-button {
      -webkit-appearance: none !important;
    }
    /* Order Search Styles */
    .order-search-wrapper {
      position: relative;
    }

    .order-search-box {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      padding: 0.55rem 1rem;
      border-radius: 12px;
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid rgba(255, 255, 255, 0.1);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      transition: border-color 0.3s ease, box-shadow 0.3s ease, background 0.3s ease;
    }

    .order-search-box:focus-within {
      border-color: rgba(136, 96, 208, 0.6);
      box-shadow: 0 0 0 3px rgba(136, 96, 208, 0.12), 0 4px 20px rgba(136, 96, 208, 0.08);
      background: rgba(255, 255, 255, 0.09);
    }

    .order-search-icon {
      color: rgba(255, 255, 255, 0.35);
      flex-shrink: 0;
      transition: color 0.3s ease;
    }

    .order-search-box:focus-within .order-search-icon {
      color: rgba(136, 96, 208, 0.8);
    }

    .order-search-input {
      flex: 1;
      border: none;
      outline: none;
      background: transparent;
      font-size: 0.92rem;
      color: inherit;
      letter-spacing: 0.01em;
    }

    .order-search-input::placeholder {
      color: rgba(255, 255, 255, 0.3);
      font-weight: 300;
    }

    .order-search-input:focus::placeholder {
      color: rgba(255, 255, 255, 0.18);
    }

    .order-search-clear {
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(255, 255, 255, 0.08);
      border: none;
      border-radius: 50%;
      width: 26px;
      height: 26px;
      cursor: pointer;
      color: rgba(255, 255, 255, 0.45);
      transition: all 0.2s ease;
      flex-shrink: 0;
      padding: 0;
    }

    .order-search-clear:hover {
      background: rgba(215, 38, 36, 0.2);
      color: #d72624;
    }

    .order-search-loader {
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .order-search-spinner {
      width: 18px;
      height: 18px;
      border: 2px solid rgba(136, 96, 208, 0.2);
      border-top-color: rgba(136, 96, 208, 0.8);
      border-radius: 50%;
      animation: spinOrderSearch 0.6s linear infinite;
    }

    @keyframes spinOrderSearch {
      to { transform: rotate(360deg); }
    }

    @keyframes fadeInOrderRow {
      from { opacity: 0; transform: translateY(6px); }
      to { opacity: 1; transform: translateY(0); }
    }
  </style>

