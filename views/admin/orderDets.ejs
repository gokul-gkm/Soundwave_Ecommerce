<%- include('../layout/adminlayout.ejs') -%>
<div class="container-scroller">
  <%- include('../layout/adminnav.ejs') -%>
  <div class="main-panel">
    <div class="content-wrapper" style="padding: 1.5rem 2.2rem;">
      <div class="row">
        <!-- Background Blurs -->
        <div class="circle position-fixed" style="background-color: rebeccapurple; filter: blur(140px); width: 14rem; height: 11rem; border-radius: 50%; right: 5rem; top: 15rem; z-index: 0; opacity: 0.5; pointer-events: none;"></div>
        <div class="circle position-fixed" style="background-color: rgba(0, 0, 255, 0.4); filter: blur(140px); width: 14rem; height: 11rem; border-radius: 50%; left: 18rem; top: 8rem; z-index: 0; opacity: 0.5; pointer-events: none;"></div>

        <div class="col-12 grid-margin" style="position: relative; z-index: 1;">
          <div class="order-container-glass">
            <div class="d-flex align-items-center justify-content-between mb-4">
              <div>
                <h3 class="order-page-title">Order Management</h3>
                <p class="order-page-subtitle text-muted">Track and process customer orders</p>
              </div>
            </div>

            <!-- Search Bar -->
            <div class="order-search-wrapper mb-4">
              <div class="order-search-box">
                <i class="ri-search-line order-search-icon"></i>
                <input
                  type="text"
                  id="orderSearchInput"
                  class="order-search-input"
                  placeholder="Search orders by name, ID or status..."
                  autocomplete="off"
                />
                <div class="order-search-loader" id="orderSearchLoader" style="display:none;">
                  <div class="order-search-spinner"></div>
                </div>
                <button class="order-search-clear" id="orderSearchClear" style="display:none;" title="Clear search">
                  <i class="ri-close-line"></i>
                </button>
              </div>
            </div>

            <div class="table-responsive">
              <table class="order-custom-table">
                <thead>
                  <tr>
                    <th style="width: 70px;">No</th>
                    <th>Customer</th>
                    <th>Total</th>
                    <th class="d-none d-md-table-cell">Method</th>
                    <th class="d-none d-lg-table-cell">Date</th>
                    <th>Status</th>
                    <th class="text-end" style="width: 140px;">Actions</th>
                  </tr>
                </thead>
                <tbody id="orderTableBody">
                  <% locals.orderList.forEach((elem, i) => { %>
                  <tr class="order-row" id="c<%= elem._id %>" style="--row-delay: <%= (i * 0.05).toFixed(2) + 's' %>;">
                    <td class="order-index"><%= i + 1 %></td>
                    <td>
                      <div class="order-client-cell">
                        <span class="order-client-name"><%= elem.userId ? elem.userId.name : 'Guest User' %></span>
                        <span class="order-id d-block d-md-none text-muted" style="font-size: 0.75rem;">#<%= elem._id.toString().slice(-6).toUpperCase() %></span>
                      </div>
                    </td>
                    <td>
                      <span class="order-amount">₹<%= elem.orderAmount.toFixed(2) %></span>
                    </td>
                    <td class="d-none d-md-table-cell">
                      <span class="order-payment-mode"><%= elem.peyment %></span>
                    </td>
                    <td class="d-none d-lg-table-cell">
                      <span class="order-date"><%= elem.orderDate.toString().split(' ').slice(0,4).join(' ') %></span>
                    </td>
                    <td>
                      <div class="order-status-badge <%= elem.orderStatus.toLowerCase().replace(' ', '-') %>">
                        <%= elem.orderStatus %>
                      </div>
                    </td>
                    <td class="text-end">
                      <div class="d-flex justify-content-center align-items-center gap-3">
                        <a href="/admin/orders/<%= elem._id %>" class="order-icon-btn info" title="Order Details">
                          <i class="ri-eye-line"></i>
                        </a>
                        <button onclick="confirmRemoval('<%= elem._id %>')" class="order-icon-btn delete" title="Delete Order">
                          <i class="ri-delete-bin-line"></i>
                        </button>
                      </div>
                    </td>
                  </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>

            <div id="orderPaginationContainer" class="mt-4">
              <%- include('../layout/pagination.ejs') -%>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
  function confirmRemoval(id) {
    Swal.fire({
      title: "Delete Order?",
      text: "This action cannot be undone. Make sure you want to remove this record.",
      icon: "warning",
      showCancelButton: true,
      confirmButtonColor: "#8860d0",
      cancelButtonColor: "#d33",
      confirmButtonText: "Yes, delete it!",
      background: '#12151c',
      color: '#fff'
    }).then((result) => {
      if (result.isConfirmed) {
        fetch(`/admin/orders/${id}`, { method: 'DELETE' })
          .then(res => res.json())
          .then(data => {
            if (data.succes) {
              const row = document.getElementById(`c${id}`);
              row.style.opacity = '0';
              row.style.transform = 'translateX(20px)';
              setTimeout(() => row.remove(), 300);
              Swal.fire({
                title: "Deleted!",
                text: "Order record removed.",
                icon: "success",
                timer: 1000,
                showConfirmButton: false,
                background: '#12151c',
                color: '#fff'
              });
            }
          })
          .catch(err => console.error('Error:', err));
      }
    });
  }

  // Order Search Logic
  (function() {
    const searchInput = document.getElementById('orderSearchInput');
    const searchLoader = document.getElementById('orderSearchLoader');
    const searchClear = document.getElementById('orderSearchClear');
    const tableBody = document.getElementById('orderTableBody');
    const paginationContainer = document.getElementById('orderPaginationContainer');
    let debounceTimer = null;

    searchInput.addEventListener('input', function() {
      const query = this.value.trim();
      searchClear.style.display = query.length > 0 ? 'flex' : 'none';
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(() => performSearch(query, 1), 400);
    });

    searchClear.addEventListener('click', function() {
      searchInput.value = '';
      searchClear.style.display = 'none';
      performSearch('', 1);
      searchInput.focus();
    });

    function performSearch(query, page) {
      searchLoader.style.display = 'flex';
      fetch(`/admin/orders?q=${encodeURIComponent(query)}&page=${page}`, {
        headers: { 'Accept': 'application/json' }
      })
      .then(res => res.json())
      .then(data => {
        renderTable(data.orderList, data.currentPage);
        // pagination rerender logic if needed
        searchLoader.style.display = 'none';
      })
      .catch(err => {
        console.error('Search error:', err);
        searchLoader.style.display = 'none';
      });
    }

    function renderTable(orders, currentPage) {
      if (!orders || orders.length === 0) {
        tableBody.innerHTML = `
          <tr><td colspan="7" style="text-align:center; padding: 4rem 0;">
            <div class="order-empty-state">
              <i class="ri-inbox-archive-line"></i>
              <p>No orders matched your search</p>
            </div>
          </td></tr>`;
        return;
      }
      const limit = 5;
      const startIndex = (currentPage - 1) * limit;
      tableBody.innerHTML = orders.map((elem, i) => {
        const clientName = elem.userId ? elem.userId.name : 'Guest User';
        const orderDateStr = new Date(elem.orderDate).toString().split(' ').slice(0,4).join(' ');
        const statusClass = elem.orderStatus.toLowerCase().replace(' ', '-');
        
        return `
          <tr class="order-row" id="c${elem._id}" style="--row-delay: ${(i * 0.05).toFixed(2) + 's'};">
            <td class="order-index">${startIndex + i + 1}</td>
            <td>
              <div class="order-client-cell">
                <span class="order-client-name">${clientName}</span>
                <span class="order-id d-block d-md-none text-muted" style="font-size: 0.75rem;">#${elem._id.toString().slice(-6).toUpperCase()}</span>
              </div>
            </td>
            <td><span class="order-amount">₹${elem.orderAmount.toFixed(2)}</span></td>
            <td class="d-none d-md-table-cell"><span class="order-payment-mode">${elem.peyment}</span></td>
            <td class="d-none d-lg-table-cell"><span class="order-date">${orderDateStr}</span></td>
            <td><div class="order-status-badge ${statusClass}">${elem.orderStatus}</div></td>
            <td class="text-end">
              <div class="d-flex justify-content-end align-items-center gap-3">
                <a href="/admin/orders/${elem._id}" class="order-icon-btn info"><i class="ri-eye-line"></i></a>
                <button onclick="confirmRemoval('${elem._id}')" class="order-icon-btn delete"><i class="ri-delete-bin-line"></i></button>
              </div>
            </td>
          </tr>`;
      }).join('');
    }
  })();
</script>

<style>
  :root {
    --accent: #8860d0;
    --glass-bg: rgba(255, 255, 255, 0.04);
    --glass-border: rgba(255, 255, 255, 0.08);
    --text-soft: rgba(255, 255, 255, 0.6);
  }

  .order-container-glass {
    background: var(--glass-bg);
    backdrop-filter: blur(20px);
    border: 1px solid var(--glass-border);
    border-radius: 24px;
    padding: 1.5rem;
    min-height: 75vh;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
  }

  .order-page-title { font-size: 1.6rem; font-weight: 700; margin-bottom: 0.2rem; }
  .order-page-subtitle { font-size: 0.9rem; }

  /* Search Styles */
  .order-search-box {
    display: flex; align-items: center; gap: 0.8rem; padding: 0.65rem 1.1rem;
    border-radius: 14px; background: rgba(0, 0, 0, 0.2);
    border: 1px solid var(--glass-border); transition: all 0.3s ease;
  }
  .order-search-box:focus-within { border-color: var(--accent); background: rgba(0, 0, 0, 0.3); }
  .order-search-icon { color: var(--text-soft); font-size: 1.1rem; }
  .order-search-input { flex: 1; border: none; outline: none; background: transparent; color: #fff; font-size: 0.9rem; }

  /* Table Styles */
  .order-custom-table { width: 100%; border-collapse: separate; border-spacing: 0 8px; }
  .order-custom-table th { padding: 1.1rem 0.8rem; color: var(--text-soft); font-size: 0.75rem; text-transform: uppercase; font-weight: 700; border-bottom: 1px solid var(--glass-border); }
  .order-row { opacity: 0; animation: fadeInOrderRow 0.4s ease forwards; animation-delay: var(--row-delay, 0s); }
  .order-row td { padding: 1rem 0.8rem; background: rgba(255, 255, 255, 0.02); border-top: 1px solid var(--glass-border); border-bottom: 1px solid var(--glass-border); vertical-align: middle; }
  .order-row td:first-child { border-left: 1px solid var(--glass-border); border-top-left-radius: 12px; border-bottom-left-radius: 12px; }
  .order-row td:last-child { border-right: 1px solid var(--glass-border); border-top-right-radius: 12px; border-bottom-right-radius: 12px; }
  .order-row:hover td { background: rgba(255, 255, 255, 0.05); }

  .order-index { color: var(--text-soft); font-family: monospace; font-size: 0.85rem; }
  .order-client-name { font-weight: 600; color: #fff; font-size: 0.95rem; }
  .order-amount { font-weight: 700; color: #fff; font-size: 0.95rem; }
  .order-payment-mode, .order-date { font-size: 0.85rem; color: var(--text-soft); }

  /* Status Badges */
  .order-status-badge {
    padding: 0.35rem 0.8rem; border-radius: 20px; font-size: 0.7rem; font-weight: 700; text-transform: uppercase;
    display: inline-flex; align-items: center; justify-content: center; min-width: 90px;
  }
  .order-status-badge.delivered { background: rgba(0, 176, 50, 0.12); color: #00ff4c; border: 1px solid rgba(0, 176, 50, 0.2); }
  .order-status-badge.shipped { background: rgba(136, 96, 208, 0.12); color: #b088ff; border: 1px solid rgba(136, 96, 208, 0.2); }
  .order-status-badge.pending { background: rgba(255, 171, 0, 0.12); color: #ffab00; border: 1px solid rgba(255, 171, 0, 0.2); }
  .order-status-badge.canceled, .order-status-badge.returned { background: rgba(215, 38, 36, 0.12); color: #ff4d4d; border: 1px solid rgba(215, 38, 36, 0.2); }

  .order-icon-btn {
    width: 34px; height: 34px; display: flex; align-items: center; justify-content: center;
    border-radius: 8px; transition: all 0.2s ease; background: rgba(255, 255, 255, 0.04); border: 1px solid var(--glass-border); cursor: pointer; text-decoration: none;
  }
  .order-icon-btn.info { color: #8860d0; }
  .order-icon-btn.delete { color: #ff4d4d; }
  .order-icon-btn:hover { background: rgba(255, 255, 255, 0.15); transform: translateY(-2px); text-decoration: none; }

  .order-empty-state { padding: 4rem 0; text-align: center; opacity: 0.4; }
  .order-empty-state i { font-size: 3rem; margin-bottom: 0.8rem; display: block; }

  @keyframes fadeInOrderRow { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
  .order-search-spinner { width: 18px; height: 18px; border: 2px solid rgba(136, 96, 208, 0.2); border-top-color: var(--accent); border-radius: 50%; animation: spinOrderSearch 0.6s linear infinite; }
  @keyframes spinOrderSearch { to { transform: rotate(360deg); } }

  /* Responsive Adjustments */
  @media (max-width: 768px) {
    .order-container-glass { padding: 1rem; }
    .order-page-title { font-size: 1.4rem; }
    .order-custom-table th, .order-row td { padding: 0.8rem 0.5rem; }
    .order-client-name { font-size: 0.85rem; }
    .order-amount { font-size: 0.85rem; }
    .order-status-badge { min-width: 70px; font-size: 0.65rem; }
  }

  body::-webkit-scrollbar { width: 0; }
  body { overflow: hidden !important; background: #0f1116; }
  .container-scroller { overflow: hidden; }
</style>

<script src="/vendors/js/vendor.bundle.base.js"></script>
<script src="/js/off-canvas.js"></script>
<script src="/js/hoverable-collapse.js"></script>
<script src="/js/misc.js"></script>
<script src="/js/settings.js"></script>
<script src="/js/todolist.js"></script>
</body>
</html>