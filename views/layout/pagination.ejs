<div class="pg-container-glass mt-4" id="paginationContainer">
  <nav aria-label="Page navigation">
    <ul class="pg-list">
      <!-- Previous Button -->
      <% if (currentPage > 1) { %>
      <li class="pg-item">
        <a class="pg-link pg-arrow" href="?page=<%= currentPage - 1 %><%= locals.q ? '&q=' + locals.q : '' %>" aria-label="Previous">
          <i class="ri-arrow-left-s-line"></i>
        </a>
      </li>
      <% } else { %>
      <li class="pg-item disabled">
        <span class="pg-link pg-arrow"><i class="ri-arrow-left-s-line"></i></span>
      </li>
      <% } %>

      <!-- Page Numbers -->
      <!-- Only show nearby pages for a professional look if totalPages is large -->
      <% 
        let startPage = Math.max(1, currentPage - 2);
        let endPage = Math.min(totalPages, currentPage + 2);
        
        if (startPage > 1) { %>
          <li class="pg-item">
            <a class="pg-link" href="?page=1<%= locals.q ? '&q=' + locals.q : '' %>">1</a>
          </li>
          <% if (startPage > 2) { %>
            <li class="pg-item disabled"><span class="pg-link pg-dots">...</span></li>
          <% } %>
        <% } %>

        <% for (let i = startPage; i <= endPage; i++) { %>
        <li class="pg-item <%= currentPage === i ? 'active' : '' %>">
          <a class="pg-link" href="?page=<%= i %><%= locals.q ? '&q=' + locals.q : '' %>"><%= i %></a>
        </li>
        <% } %>

        <% if (endPage < totalPages) { %>
          <% if (endPage < totalPages - 1) { %>
            <li class="pg-item disabled"><span class="pg-link pg-dots">...</span></li>
          <% } %>
          <li class="pg-item">
            <a class="pg-link" href="?page=<%= totalPages %><%= locals.q ? '&q=' + locals.q : '' %>"><%= totalPages %></a>
          </li>
        <% } %>

      <!-- Next Button -->
      <% if (currentPage < totalPages) { %>
      <li class="pg-item">
        <a class="pg-link pg-arrow" href="?page=<%= currentPage + 1 %><%= locals.q ? '&q=' + locals.q : '' %>" aria-label="Next">
          <i class="ri-arrow-right-s-line"></i>
        </a>
      </li>
      <% } else { %>
      <li class="pg-item disabled">
        <span class="pg-link pg-arrow"><i class="ri-arrow-right-s-line"></i></span>
      </li>
      <% } %>
    </ul>
  </nav>
</div>

<style>
  :root {
    --pg-accent: #8860d0;
    --pg-glass: rgba(255, 255, 255, 0.05);
    --pg-border: rgba(255, 255, 255, 0.1);
    --pg-text: rgba(255, 255, 255, 0.7);
  }

  .pg-container-glass {
    display: flex;
    justify-content: center;
    padding: 0.5rem;
  }

  .pg-list {
    display: flex;
    list-style: none;
    padding: 0;
    margin: 0;
    gap: 0.5rem;
    align-items: center;
    background: rgba(0, 0, 0, 0.2);
    padding: 6px;
    border-radius: 14px;
    border: 1px solid var(--pg-border);
    backdrop-filter: blur(10px);
  }

  .pg-item {
    display: inline-block;
  }

  .pg-link {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 38px;
    height: 38px;
    padding: 0 8px;
    border-radius: 10px;
    background: transparent;
    color: var(--pg-text);
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    border: 1px solid transparent;
  }

  .pg-link:hover:not(.pg-dots) {
    background: var(--pg-glass);
    color: #fff;
    border-color: var(--pg-border);
    transform: translateY(-2px);
    text-decoration: none;
  }

  .pg-item.active .pg-link {
    background: var(--pg-accent);
    color: #fff;
    box-shadow: 0 4px 12px rgba(136, 96, 208, 0.3);
    border-color: var(--pg-accent);
  }

  .pg-arrow {
    font-size: 1.2rem;
    background: rgba(255, 255, 255, 0.03);
  }

  .pg-item.disabled .pg-link {
    opacity: 0.3;
    pointer-events: none;
    transform: none;
  }

  .pg-dots {
    cursor: default;
    border: none;
    font-weight: bold;
    min-width: 25px;
  }

  /* Responsive tweaks */
  @media (max-width: 576px) {
    .pg-link {
      min-width: 32px;
      height: 32px;
      font-size: 0.8rem;
    }
  }
</style>