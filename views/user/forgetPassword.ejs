<%- include('../layout/header.ejs') -%>
<link rel="stylesheet" href="/css/mycss/forget-password.css">
</head>

<body>
  <div class="page-wrapper">

    <header class="header">
      <div class="header-middle sticky-header">
        <div class="container">
          <div class="header-left">
            <button class="mobile-menu-toggler">
              <span class="sr-only">Toggle mobile menu</span>
              <i class="icon-bars"></i>
            </button>
            <a href="/" class="logo">
              <img src="/images/soundwave/logoblack.png" alt="Soundwave Logo" width="105" height="25">
            </a>
            <nav class="main-nav">
              <ul class="menu">
                <li class="megamenu-container active"><a href="/">Home</a></li>
                <li><a href="/products">Products</a></li>
                <li>
                  <a class="sf-with-ul">Category</a>
                  <ul>
                    <li><a href="/products">Headphones</a></li>
                    <li><a href="/products">Earbuds</a></li>
                    <li><a href="/products">Speakers</a></li>
                    <li><a href="/products">Soundbars</a></li>
                  </ul>
                </li>
                <li><a href="/about">About</a></li>
              </ul>
            </nav>
          </div>
        </div>
      </div>
    </header>

    <nav aria-label="breadcrumb" class="breadcrumb-nav border-0 mb-0">
      <div class="container">
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="/">Home</a></li>
          <li class="breadcrumb-item"><a href="/login">Login</a></li>
          <li class="breadcrumb-item active" aria-current="page">Forgot Password</li>
        </ol>
      </div>
    </nav>

    <!-- ─── Main Auth Section ─────────────────────────────── -->
    <main class="main">
      <section class="auth-page">
        <div class="auth-card">

          <!-- ── Brand / Header Strip ──────────────────────── -->
          <div class="auth-brand">
            <a href="/login" class="auth-back-link" aria-label="Back to login">
              <i class="fas fa-arrow-left"></i>
              <span>Back</span>
            </a>

            <div class="auth-icon-badge">
              <i class="fas fa-lock"></i>
            </div>

            <h1 class="auth-brand-title">Forgot password?</h1>
            <p class="auth-brand-subtitle">
              No worries — enter your email and<br>we'll send you a reset OTP.
            </p>
          </div>

          <!-- ── Form Body ──────────────────────────────────── -->
          <div class="auth-body">

            <!-- Default form state -->
            <div id="form-state">
              <form id="forget-form" action="/forget-password" method="post" novalidate>

                <div class="auth-form-group">
                  <label class="auth-label" for="forget-email">Email Address</label>
                  <div class="auth-input-wrap">
                    <input
                      type="email"
                      class="auth-input"
                      id="forget-email"
                      name="email"
                      placeholder="you@example.com"
                      autocomplete="email"
                      oninput="checkForgetEmail(this)"
                      required
                    >
                  </div>
                  <span id="email-status" class="auth-email-status" aria-live="polite"></span>
                </div>

                <button
                  type="submit"
                  class="auth-btn"
                  id="forget-submit-btn"
                  disabled
                >
                  <span class="btn-label">Send OTP</span>
                  <i class="icon-long-arrow-right btn-icon"></i>
                </button>

              </form>

              <div class="auth-footer">
                <p class="auth-footer-text">
                  Remember your password?
                  <a href="/login">Sign in</a>
                </p>
              </div>
            </div>

            <div class="auth-success-state" id="success-state">
              <div class="auth-success-icon">
                <i class="fas fa-envelope-open-text"></i>
              </div>
              <h2 class="auth-success-title">OTP Sent!</h2>
              <p class="auth-success-text">
                We've sent a 4-digit OTP to<br>
                <strong id="sent-email" style="color:#333;"></strong><br>
                Check your inbox and enter the code.
              </p>
              <a href="/otp" class="auth-btn" style="text-decoration:none; margin-top: 0;">
                <span class="btn-label">Enter OTP</span>
                <i class="icon-long-arrow-right btn-icon"></i>
              </a>
            </div>

          </div><!-- /.auth-body -->

        </div><!-- /.auth-card -->
      </section>
    </main>

    <%- include('../layout/lyfooter.ejs') -%>
  </div><!-- /.page-wrapper -->

  <button id="scroll-top" title="Back to Top"><i class="icon-arrow-up"></i></button>
  <%- include('../layout/mobMenu.ejs') -%>

  <!-- ─── Scripts ──────────────────────────────────────────── -->
  <script>
    const submitBtn  = document.getElementById('forget-submit-btn');
    const statusEl   = document.getElementById('email-status');
    const emailInput = document.getElementById('forget-email');
    const formState  = document.getElementById('form-state');
    const successState = document.getElementById('success-state');

    let emailTimer;
    let emailIsValid = false;

    // ── Live email check  ──────────────────
    function checkForgetEmail(input) {
      clearTimeout(emailTimer);

      if (!input.value || !input.value.includes('@')) {
        setStatus('', '');
        lockSubmit();
        return;
      }

      setStatus('loading', '&#8203;Checking…');

      emailTimer = setTimeout(() => {
        fetch('/forget-email-exists', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ payload: input.value })
        })
        .then(r => r.json())
        .then(data => {
          if (data.emailExist) {
            setStatus('ok', '✓ &nbsp;Account found');
            input.classList.remove('input-error');
            input.classList.add('input-success');
            emailIsValid = true;
            unlockSubmit();
          } else {
            setStatus('err', '✕ &nbsp;No account found with this email');
            input.classList.add('input-error');
            input.classList.remove('input-success');
            emailIsValid = false;
            lockSubmit();
          }
        })
        .catch(() => {
          setStatus('err', '✕ &nbsp;Could not verify email');
          lockSubmit();
        });
      }, 500);
    }

    function setStatus(cls, html) {
      statusEl.innerHTML = html;
      statusEl.className = 'auth-email-status' + (cls ? ' ' + cls : '');
    }

    function lockSubmit() {
      submitBtn.disabled = true;
    }

    function unlockSubmit() {
      submitBtn.disabled = false;
    }

    // ── Form submit ─────────
    document.getElementById('forget-form').addEventListener('submit', function(e) {
      if (!emailIsValid) {
        e.preventDefault();
        return;
      }

      submitBtn.classList.add('loading');
      submitBtn.disabled = true;

      document.getElementById('sent-email').textContent = emailInput.value;

    });

    document.getElementById('forget-form').addEventListener('keydown', function(e) {
      if (e.key === 'Enter' && !emailIsValid) e.preventDefault();
    });
  </script>

  <style>
    *::-webkit-scrollbar { width: 0; }
  </style>

  <script src="https://cdn.jsdelivr.net/npm/locomotive-scroll@3.5.4/dist/locomotive-scroll.js" defer></script>
  <script src="/js/demos/demo-6.js"></script>
  <script src="https://unpkg.com/@studio-freight/lenis@1.0.33/dist/lenis.min.js" defer></script>
  <%- include('../layout/footer.ejs') -%>
  <script src="/js/base.js"></script>
</body>
</html>