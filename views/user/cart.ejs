<%- include('../layout/header.ejs')-%>

    <body>
        <div class="page-wrapper">
            <%- include('../layout/navbar.ejs') -%>


                <main class="main">
                    <div class=" text-center"
                        >
                        <div class="container">
                            <h3 class="page-title">Shopping Cart</h3>
                        </div><!-- End .container -->
                    </div><!-- End .page-header -->
                    <nav aria-label="breadcrumb" class="breadcrumb-nav">
                        <div class="container">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item"><a href="/">Home</a></li>
                                <li class="breadcrumb-item"><a href="/products">Products</a></li>
                                <li class="breadcrumb-item active" aria-current="page">Shopping Cart</li>
                            </ol>
                        </div><!-- End .container -->
                    </nav><!-- End .breadcrumb-nav -->

                    <div class="page-content">
                        <div class="cart">
                            <div class="container">
                                <% if(locals.cartCount > 0){ %>
                                <div class="row">
                                    <div class="col-lg-9">
                                       
                                        <table class="table table-cart table-mobile">
                                            <thead>
                                                <tr>
                                                    <th>Product</th>
                                                    <th>Price</th>
                                                    <th>Quantity</th>
                                                    <th>Total</th>
                                                    <th></th>
                                                </tr>
                                            </thead>

                                            <tbody>
                                                <% if(locals.cart) {%>
                                                <% cart.products.forEach((product, index)=> { %>
                                                    <tr id="c<%= product.productId._id%>">
                                                        <td class="product-col">
                                                            <div class="product">
                                                                <figure class="product-media">
                                                                    <a href="">
                                                                        <img src="<%= product.productId.images[0] %>"
                                                                        alt="Product image">
                                                                    </a>
                                                                </figure>
                                                                <h3 class="product-title">
                                                                    <a href="#">
                                                                        <%= product.productId.name %>
                                                                    </a>
                                                                </h3>
                                                            </div>
                                                        </td>
                                                        <td class="price-col ">₹<%=product.productId.price %>
                                                        </td>
                                                        <td class="quantity-col">
                                                            <div class="cart-product-quantity">
                                                                <input type="number" class="form-control"
                                                                    oninput="stock(this,'<%=product.productId.price %>','<%=product.productId._id  %>','<%= locals.cart._id%>')"
                                                                    value="<%= product.quantity %>" min="1"
                                                                    max="<%=product.productId.stock%>" step="1"
                                                                    data-decimals="0" required>
                                                            </div>
                                                        </td>
                                                        <td class="total-col "id='price<%=product.productId._id  %>'>₹<%=
                                                               product.price %>
                                                        </td>
                                                        <td class="remove-col">
                                                            <button onclick="remove('<%=product.productId._id  %>','<%= locals.cart._id%>','<%=product.price %>','<%= totalprice %>')" class="btn-remove"><i
                                                                    class="icon-close"></i></button>
                                                        </td>
                                                    </tr>
                                                    <% }) %>
                                                    <% } %>
                                            </tbody>

                                        </table><!-- End .table table-wishlist -->

                                        <div class="cart-bottom">
                                            <div class="cart-discount">
                                                <form id="couponForm" onsubmit="applyCoupon(event)">
                                                    <div class="input-group">
                                                        <input type="text" id="couponInput" name="id" class="form-control" required
                                                            placeholder="Coupon code" oninput="check(this)">
                                                        <div id="codeSubmit" class="input-group-append" style="opacity:.6;pointer-events:none">
                                                            <button class="btn btn-outline-primary-2" type="submit" id="couponBtn">
                                                                <i class="icon-long-arrow-right" id="couponBtnIcon"></i>
                                                            </button>
                                                        </div><!-- .End .input-group-append -->
                                                    </div>
                                                    <p id="msg" class="mt-1"></p><!-- End .input-group -->
                                                </form>
                                            </div>

                                            <a href="/cart?id=<%=login%>" class="btn btn-outline-dark-2"><span>UPDATE CART</span><i
                                                    class="icon-refresh"></i></a>
                                        </div>
                                    </div>
                                    <aside class="col-lg-3">
                                        <div class="summary summary-cart">
                                            <h3 class="summary-title">Cart Total</h3><!-- End .summary-title -->

                                            <table class="table table-summary">
                                                <tbody>
                                                    <tr class="summary-subtotal">
                                                        <td>Subtotal:</td>
                                                        <td id="sub-total">₹<%= totalprice %></td>
                                                    </tr><!-- End .summary-subtotal -->
                                                    <tr class="summary-shipping">
                                                        <td>Shipping:</td>
                                                        <td>&nbsp;</td>
                                                    </tr>

                                                    <tr class="summary-shipping-row">
                                                        <td>
                                                            <div class="custom-control custom-radio">
                                                                <input type="radio" id="free-shipping" name="shipping"
                                                                    class="custom-control-input" checked>
                                                                <label class="custom-control-label"
                                                                    for="free-shipping">Free Shipping</label>
                                                            </div><!-- End .custom-control -->
                                                        </td>
                                                        <td>₹0.00</td>
                                                    </tr><!-- End .summary-shipping-row -->

                                                 

                                     <!-- End .summary-shipping-row -->

                                                    <tr class="summary-shipping-estimate">
                                                        <td>Estimate for Your Country<br> <a
                                                                href="/address">Change address</a></td>
                                                        <td>&nbsp;</td>
                                                    </tr><!-- End .summary-shipping-estimate -->

                                                    <tr class="summary-total">
                                                        <td>Total:</td>
                                                        <td id="total">₹<%= totalprice %></td>
                                                    </tr><!-- End .summary-total -->
                                                </tbody>
                                            </table><!-- End .table table-summary -->
                                            <% if(locals.cartCount > 0){ %>
                                            <a href="/checkout"
                                                class="btn btn-outline-primary-2 btn-order btn-block">PROCEED TO
                                                CHECKOUT</a>
                                            <% } else { %>
                                                <a 
                                                class="btn btn-outline-primary-2 btn-order btn-block">Cart is Empty</a>
                                                <% } %>
                                        </div><!-- End .summary -->

                                        <a href="/shop"
                                            class="btn btn-outline-dark-2 btn-block mb-3"><span>CONTINUE
                                                SHOPPING</span><i class="icon-refresh"></i></a>
                                    </aside><!-- End .col-lg-3 -->
                                </div><!-- End .row -->
                                <% } else { %>
                                    <div class="text-center text-primary fs-2">Cart is Empty</div>
                                <% } %>
                            </div><!-- End .container -->
                        </div><!-- End .cart -->
                    </div><!-- End .page-content -->
                </main>

                <%- include('../layout/lyfooter.ejs') -%>
        </div>
        <button id="scroll-top" title="Back to Top"><i class="icon-arrow-up"></i></button>


        <%- include('../layout/mobMenu.ejs') -%>

            <script>
                const codeSubmit = document.getElementById('codeSubmit');
                const msgEl = document.getElementById('msg');

                function check(e) {
                    if (e.value.trim() == '') {
                        codeSubmit.style.opacity = .6;
                        codeSubmit.style.pointerEvents = 'none';
                    } else {
                        codeSubmit.style.opacity = 1;
                        codeSubmit.style.pointerEvents = 'all';
                    }
                }

                async function applyCoupon(e) {
                    e.preventDefault();
                    const code = document.getElementById('couponInput').value.trim();
                    const btn = document.getElementById('couponBtn');
                    const icon = document.getElementById('couponBtnIcon');

                    // Show loading state
                    btn.disabled = true;
                    icon.className = '';
                    icon.textContent = '...';
                    msgEl.textContent = '';
                    msgEl.className = 'mt-1';

                    try {
                        const res = await fetch('/coupons/apply', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ id: code })
                        });
                        const data = await res.json();

                        if (data.success) {
                            msgEl.textContent = '✓ ' + data.message;
                            msgEl.className = 'mt-1 text-success fw-bold';
                            toast('success', data.message);
                            // Redirect to checkout since coupon is now in session
                            setTimeout(() => window.location.href = '/checkout', 1200);
                        } else {
                            msgEl.textContent = data.error || 'Invalid coupon code';
                            msgEl.className = 'mt-1 text-danger';
                            toast('error', data.error || 'Invalid coupon code');
                        }
                    } catch (err) {
                        msgEl.textContent = 'Something went wrong. Please try again.';
                        msgEl.className = 'mt-1 text-danger';
                        toast('error', 'Something went wrong. Please try again.');
                    } finally {
                        btn.disabled = false;
                        icon.className = 'icon-long-arrow-right';
                        icon.textContent = '';
                    }
                }

                function stock(e,price,productId,id){
                    const Tprice= document.getElementById(`price${productId}`)
                    const Total= document.getElementById(`total`)
                    const sub= document.getElementById(`sub-total`)
                  
                   fetch('/cart-update',{
                    method: 'PATCH',
						headers: { "Content-Type": "application/json" },
						body: JSON.stringify({ quantity: e.value,id,productId })
                   }).then(res=>res.json()).then(data=>{
                    if(data.su){
                        Tprice.textContent=`₹${e.value*price}`;
                        Total.textContent=`₹${data.su}`;
                        sub.textContent=`₹${data.su}`;
                        
                    }
                   })
                }

                function remove(proid,id,prize,tp){
                    const tot=tp-prize
                    const Total= document.getElementById(`total`)
                    const sub= document.getElementById(`sub-total`)
                  
                    const cartDet= document.getElementById(`c${proid}`)
                    fetch('/cart',{
                    method: 'delete',
						headers: { "Content-Type": "application/json" },
						body: JSON.stringify({proid,id,tot})
                   }).then(res=>res.json()).then(data=>{
                    if(data.rdata){
                        console.log(data.rdata)
                        cartDet.remove();
                        Total.textContent=tot
                        sub.textContent=tot
                        if (data.newCount !== undefined) updateCartCount(data.newCount);
                    }
                   })
                   
                }
            </script>

            <style>
                body::-webkit-scrollbar {
                    width: 0;
                }
            </style>
            <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
            <script>
                function toast(icon, title) {
                    const Toast = Swal.mixin({
                        toast: true,
                        position: 'top-end',
                        showConfirmButton: false,
                        timer: 3000,
                        timerProgressBar: true,
                    });
                    Toast.fire({ icon, title });
                }
            </script>
            <script src="https://unpkg.com/@studio-freight/lenis@1.0.33/dist/lenis.min.js" defer></script>
            <script src="js/base.js"></script>
            <%- include('../layout/footer.ejs') -%>